# ClubOS environment variables
# Copy to .env and fill in real values. Never commit .env to git.

# Database (Supabase Postgres connection string)
DATABASE_URL=postgresql://postgres:PASSWORD@HOST.supabase.co:5432/postgres

# Server
NODE_ENV=development
PORT=5001
SESSION_SECRET=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_PUBLISHABLE_KEY=

# Email (Resend)
RESEND_API_KEY=

# Meta tracking (Facebook Pixel + Conversions API)
META_PIXEL_ID=
VITE_META_PIXEL_ID=
META_ACCESS_TOKEN=

# DNS automation (GoDaddy)
GODADDY_API_KEY=
GODADDY_API_SECRET=

# Initial admin user (used by seed script on first boot)
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

# Object storage — TODO: replace Replit storage with Supabase Storage credentials
# (will be wired in next phase, app boots without these for now)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=clubos-uploads

# USG Documents access-log proxy (Business Plan tab in MFL workspace)
DOCS_ADMIN_TOKEN=
DOCS_BASE_URL=https://business.minifootball.co.nz

# CIC Watch OTT platform
SUPABASE_MEET_URL=
SUPABASE_MEET_SERVICE_ROLE_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_TOKEN=

# Sporty / NZ Football NRS (Football API). UAT keys come from NZ Football
# (Rodrigo Stephanou) once development is confirmed complete; live keys only
# after UAT passes + both deeds are signed. SPORTY_BASE_URL defaults to UAT —
# production (https://www.sporty.co.nz) must be set EXPLICITLY at go-live.
SPORTY_BASE_URL=https://uat.sporty.co.nz
SPORTY_API_KEY=
SPORTY_API_USERNAME=
SPORTY_API_PASSWORD=
# 1 = hourly auto-push of new/changed CUFC registrations (default off: manual
# pushes from the Sporty tab only).
SPORTY_AUTOSYNC=0
