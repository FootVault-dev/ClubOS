":209,"green":193,"blue":194}}},"tags":[],"private_tags":[],"user":{"id":"gGARcL6","first_name":"Administration","last_name":"Manager","avatar_url":"","cw_admin":false,"last_active_date":"2026-06-30 05:16:24"},"amnesty_expiry":"2024-07-06 00:27:50","created_date":"2024-07-05 00:27:50","average_rating":0,"sender_organisation":null,"attributed_image":null,"noindex":false,"deleted_date":null},"hero_video":null,"url":"https:\/\/hail.to\/selwyn\/article\/DaC55YF","hail_url":"https:\/\/hail.to\/selwyn\/article\/DaC55YF","order":null},"title":"Fundraising Guidance"},"depth":1,"parent":24852,"left":96,"right":97}],"depth":1,"parent":null,"left":87,"right":98},{"id":"xJ7NfSH","name":"Newsletter","type":"folder","in_use":false,"display_homepage":true,"display_magazines":false,"display_gazettes":false,"display_newsletters":false,"display_noticeboards":false,"display_blogs":false,"display_yearbooks":false,"display_articles":false,"ordering_id":24608,"children":[{"id":"n5Vlv3D","name":"SUFC Shout July 2025","type":"link","in_use":true,"display_homepage":true,"display_magazines":false,"display_gazettes":true,"display_newsletters":false,"display_noticeboards":false,"display_blogs":false,"display_yearbooks":false,"display_articles":false,"ordering_id":33106,"association":{"type":"article","entity":{"id":"RjUEdV5","title":"SUFC Shout - July Edition","author":"Alex Smith","show_author":true,"lead":null,"body":"<p>Winter has hit the season hard but there's still plenty to celebrate at the club - more milestones and plenty of school holiday fun!<\/p>\n\n<h4><strong>In this issue:<\/strong><\/h4>\n\n<ul><li><p>Upcoming fixtures for our Men\u2019s and Women\u2019s First Teams<\/p><\/li><li><p>A special 100-cap celebration for Women's First Team player Olivia Dyer<\/p><\/li><li><p>Member of the Month \u2013 Ethan Bryant<\/p><\/li><li><p>Meet the Teams: 13th Grade Black &amp; the Selwyn Silver Stallions<\/p><\/li><\/ul>\n\n<p>Click below to check it out!<\/p>\n\n<p>Got something you\u2019d