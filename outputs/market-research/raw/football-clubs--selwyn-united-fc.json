}},"secondary":{"rgb":{"red":136,"green":162,"blue":97}},"detail":{"rgb":{"red":223,"green":129,"blue":66}}},"tags":[],"private_tags":[],"user":{"id":"gGARcL6","first_name":"Administration","last_name":"Manager","avatar_url":"","cw_admin":false,"last_active_date":"2026-06-30 05:16:24"},"amnesty_expiry":"2023-01-24 21:10:13","created_date":"2023-01-23 21:10:15","average_rating":0,"sender_organisation":null,"attributed_image":null,"noindex":false,"deleted_date":null},"hero_video":null,"url":"https:\/\/hail.to\/selwyn\/article\/MUjwmnW","hail_url":"https:\/\/hail.to\/selwyn\/article\/MUjwmnW","order":null},"title":"Income &amp; Expenditure"},"depth":1,"parent":10511,"left":10,"right":11},{"id":"epqSwDE","name":"SUFC Strategic Plan","type":"link","in_use":true,"display_homepage":true,"display_magazines":true,"display_gazettes":true,"display_newsletters":true,"display_noticeboards":false,"display_blogs":true,"display_yearbooks":true,"display_articles":true,"ordering_id":10517,"association":{"type":"article","entity":{"id":"dNe7Pne","title":"Strategic Plan 2022","author":"SUFC","show_author":true,"lead":"Selwyn United Football Club (SUFC) was formed in 2013 through the amalgamation of Rolleston and Ellesmere Football Clubs. In 2015 Malvern Football club was also consolidated into the Club, making it the single Football Club in the Selwyn District.","body":"<p>After extensive consultation with a broad range of internal and external stakeholders and a membership workshop, Selwyn United FC's Strategic Plan was adopted in 2022.<\/p>\n\n<p>The plan outlines the Club's;<\/p>\n\n<p><b>Vision<\/b><\/p>\n\n<p>Enriching the lives of those in our community through the game of football<\/p>\n\n<p><b>Values<\/b><\/p>\n\n<p>Act with integrity | Foster belonging | Dare to be different<\/p>\n\n<p><b>Our Pillars<\/b><\/p>\n\n<p>Grow the Game | Relationships | Sustainability | Identity<\/p>","body_mail":"\n        <!--[if (gte mso 9)|(IE)]>\n        <table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" width=\"516\">\n        <tr>\n        <td>\n        <![endif]-->\n        <div style=\"max-width: 516px; margin: 0 auto; box-sizing: border-box; font-family: sans-serif; font-size: 18px; line-height: 1.6; color: #475569;\">\n        <p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">After extensive consultation with a broad range of internal and external stakeholders and a membership workshop, Selwyn United FC's Strategic Plan was adopted in 2022.<\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">The plan outlines the Club's;<\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\"><b style=\"font-weight: bold;\">Vision<\/b><\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">Enriching the lives of those in our community through the game of football<\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\"><b style=\"font-weight: bold;\">Values<\/b><\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">Act with integrity | Foster belonging | Dare to be different<\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\"><b style=\"font-weight: bold;\">Our Pillars<\/b><\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">Grow the Game | Relationships | Sustainability | Identity<\/p>\n        <\/div>\n        <!--[if (gte mso 9)|(IE)]>\n        <\/td>\n        <\/tr>\n        <\/table>\n        <![endif]-->","date":"2021-12-31 11:00:00","show_date":true,"editable":false,"location":null,"location_latitude":null,"location_longitude":null,"status":"published","user":{"id":"gGARcL6","first_name":"Administration","last_name":"Manager","avatar_url":"","cw_admin":false,"last_active_date":"2026-06-30 05:16:24"},"created_date":"2022-02-04 04:31:33","updated_date":"2024-05-06 05:13:56","average_rating":0,"attachments":[{"id":"tg5byNH","uploaded_name":"Selwyn United FC Strategic Plan 20