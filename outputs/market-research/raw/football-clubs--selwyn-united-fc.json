"blue":226}},"detail":{"rgb":{"red":255,"green":255,"blue":255}}},"tags":[],"private_tags":[],"user":{"id":"gGARcL6","first_name":"Administration","last_name":"Manager","avatar_url":"","cw_admin":false,"last_active_date":"2026-06-30 05:16:24"},"amnesty_expiry":"2024-12-04 03:49:33","created_date":"2024-12-03 03:49:34","average_rating":0,"sender_organisation":null,"attributed_image":null,"noindex":false,"deleted_date":null},"promo1_org_logo":"https:\/\/assets.hail-cdn.com\/fmgWy6F4toRwkW9hvwbEYe6nzTPbPxt785MgUZgzE0Gkanl9TIGijgwBNqfrWhKP3X9QpUKwx1j4SHQlUbVOkAqAqhaFWGM0cGshziIyatb32PUVm2M5hTPrqu1N0seJ","promo1_link_value":{"id":"NrfpwIN","title":"2026 Winter Football","editorial":"<p>Registrations are now open for the 2026 Winter Football season.<\/p>\n\n<p>The Senior Winter Football season starts on Saturday 11th April 2026.<\/p>\n\n<p>The Junior &amp; Youth Winter Football season starts on Saturday 2nd May 2026 and Sunday 3rd May 2026.<\/p>","private_tags":[],"due_date":"2024-01-31 11:00:00","custom_css_url":null,"status":"published","number_of_articles":10,"article_ordering":"none","style":{"id":"magazine","name":"Magazine","description":"With a focus on large, engaging photography, the \u2018Magazine\u2019 is ideal for creating an impression with brochure-like communications.","preview_url":"https:\/\/hail.to\/lets-go-fitness\/publication\/pLwicdV","available_as_bonus":false},"featured_article":null,"featured_image":null,"created_date":"2023-01-19 23:21:16","deleted_date":null,"subscribe_enabled":true,"locked":false,"noindex":false,"shared_to_app":false,"limited":false,"quick_links":[{"id":"BGqzYbc","name":"Home Page","type":"link","in_use":true,"display_homepage":false,"display_magazines":true,"display_gazettes":true,"display_newsletters":true,"display_noticeboards":false,"display_blogs":true,"display_yearbooks":true,"display_articles":true,"ordering_id":1928,"association":{"type":"url","entity":"https:\/\/hail.to\/selwyn","title":null},"depth":0,"parent":null,"left":1,"right":2},{"id":"VkGKsv6","name":"About Us","type":"folder","in_use":false,"display_homepage":true,"display_magazines":false,"display_gazettes":false,"display_newsletters":false,"display_noticeboards":false,"display_blogs":false,"display_yearbooks":false,"display_articles":false,"ordering_id":10511,"children":[{"id":"Av0AY8F","name":"About Us","type":"link","in_use":true,"display_homepage":true,"display_magazines":true,"display_gazettes":true,"display_newsletters":true,"display_noticeboards":false,"display_blogs":true,"display_yearbooks":true,"display_articles":true,"ordering_id":10512,"association":{"type":"article","entity":{"id":"4hO46bB","title":"About Us","author":"SUFC","show_author":true,"lead":"Selwyn United Football Club is pleased to welcome players, parents and supporters to our website!","body":"<p>Selwyn United Football Club is the result of the merger of Rolleston Football and Ellesmere Football Clubs in December 2012 and caters for all thing football in and around our district.&nbsp;<\/p>\n\n<p>Selwyn United Football Club has quickly established itself as one of the biggest clubs in not only Christchurch or the South Island but New Zealand. With the overwhelming strength in junior and youth participation, strong senior participation and world class facilities, the club currently boasts over 1,600 members from all over the Selwyn District.<\/p>\n\n<p>Selwyn United FC caters for males and females from the ages of 4 all the way up to over 50s giving an opportunity for people to play socially or competitively.&nbsp;<\/p>\n\n<p>Within the club there is a Skill Centre and a Talent Centre which aims to develop young footballer\u2019s skills, knowledge and understanding of the game and provide our players with a pathway to national football.&nbsp;<\/p>\n\n<p>Not only do the club offer a chance to play the game, its successful coach education and mentoring programme also allows people to become involved through coaching.&nbsp;<\/p>","body_mail":"\n        <!--[if (gte mso 9)|(IE)]>\n        <table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" width=\"516\">\n        <tr>\n        <td>\n        <![endif]-->\n        <div style=\"max-width: 516px; margin: 0 auto; box-sizing: border-box; font-family: sans-serif; font-size: 18px; line-height: 1.6; color: #475569;\">\n        <p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">Selwyn United Football Club is the result of the merger of Rolleston Football and Ellesmere Football Clubs in December 2012 and caters for all thing football in and around our district.&nbsp;<\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">Selwyn United Football Club has quickly established itself as one of the biggest clubs in not only Christchurch or the South Island but New Zealand. With the overwhelming strength in junior and youth participation, strong senior participation and world class facilities, the club currently boasts over 1,600 members from all over the Selwyn District.<\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">Selwyn United FC caters for males and females from the ages of 4 all the way up to over 50s giving an opportunity for people to play socially or competitively.&nbsp;<\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">Within the club there is a Skill Centre and a Talent Centre which aims to develop young footballer\u2019s skills, knowledge and understanding of the game and provide our players with a pathway to national football.&nbsp;<\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">Not only do the club offer a chance to play the game, its successful coach education and mentoring programme also allows people to become involved through coaching.&nbsp;<\/p>\n        <\/div>\n        <!--[if (gte mso 9)|(IE)]>\n        <\/td>\n        <\/tr>\n        <\/table>\n        <![endif]-->","date":"2022-05-21 12:00:00","show_date":true,"edi