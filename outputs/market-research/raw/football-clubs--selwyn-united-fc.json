6-30 05:16:24"},"amnesty_expiry":"2025-03-19 08:38:17","created_date":"2025-03-18 08:38:19","average_rating":0,"sender_organisation":null,"attributed_image":null,"noindex":false,"deleted_date":null},"hero_video":null,"url":"https:\/\/hail.to\/selwyn\/article\/AkXdHEe","hail_url":"https:\/\/hail.to\/selwyn\/article\/AkXdHEe","order":null},"title":"Introducing the new SUFC Newsletter!"},"depth":1,"parent":24608,"left":108,"right":109}],"depth":1,"parent":null,"left":99,"right":110},{"id":"Z1aB5qP","name":"Merchandise","type":"link","in_use":true,"display_homepage":true,"display_magazines":false,"display_gazettes":false,"display_newsletters":false,"display_noticeboards":false,"display_blogs":false,"display_yearbooks":false,"display_articles":false,"ordering_id":23919,"association":{"type":"article","entity":{"id":"mbamztS","title":"Club Merchandise","author":"SUFC","show_author":true,"lead":"Selwyn United FC club merchandise is now for sale","body":"<p>We\u2019re excited to announce that our online club merchandise store, in collaboration with Paladin Sports Ltd, is now live and ready to take orders.<\/p>\n\n<p><\/p>\n\n<p>Players and supporters can gear up for the season ahead.<\/p>\n\n<p><\/p>\n\n<p>If you would like to order any of the club merchandise, then please <a href=\"https:\/\/nz.paladin.sport\/collections\/selwyn-united-fc\" data-button-colour=\"#1f57b5\" data-button=\"true\" class=\"button-link\" style=\"background-color: #1f57b5 !important;\">CLICK HERE.&nbsp;&nbsp;<\/a><\/p>\n\n<p><br><\/p>\n\n<p>The online store is run by Paladin Sports Limited, they will process your order and have it delivered direct to you.<\/p>\n\n<p><\/p>\n\n<p>Pre-order items will take approximately 6 weeks from the shop window close date to manufacture, and approximately another week to ship to you.&nbsp;<\/p>\n\n<p><\/p>\n\n<p>The other items are held in stock and they aim to have these delivered to you within 1-2 business days.<\/p>\n\n<p><\/p>\n\n<p>If you have a mix of stock and pre order items you will be charged two delivery fees, the stock items will be delivered first and the preorder items will be delivered once they arrive from the manufacturer.<\/p>\n\n<a href=\"https:\/\/assets.hail-cdn.com\/uploads\/2000-constrained-f127b2e7-d097-4081-a5e1-3a79de27b722\" class=\"hail-inline\" target=\"_blank\" style=\"text-align: center;\" data-caption=\"\" data-people-html=\"\" data-grapher=\"\" data-width=\"1600\" data-height=\"2000\"><figure text-align=\"center\" data-hail-inline-id=\"svVQgDB\" data-hail-inline-type=\"image\" data-hail-width-percentage=\"57.392473118279575\" style=\"text-align: center;\"><div class=\"public-image-wrapper\" style=\"width: 57.392473118279575%;\"><img src=\"https:\/\/assets.hail-cdn.com\/uploads\/1000-constrained-6779050b-dc70-437d-96ae-9d468812583f\"><\/div><\/figure><\/a>","body_mail":"\n        <!--[if (gte mso 9)|(IE)]>\n        <table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" width=\"516\">\n        <tr>\n        <td>\n        <![endif]-->\n        <div style=\"max-width: 516px; margin: 0 auto; box-sizing: border-box; font-family: sans-serif; font-size: 18px; line-height: 1.6; color: #475569;\">\n        <p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">We\u2019re excited to announce that our online club merchandise store, in collaboration with Paladin Sports Ltd, is now live and ready to take orders.<\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\"><\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">Players and supporters can gear up for the season ahead.<\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\"><\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">If you would like to order any of the club merchandise, then please <a ses:no-track href=\"https:\/\/nz.paladin.sport\/collections\/selwyn-united-fc\" data-button-colour=\"#1f57b5\" data-button=\"true\" style=\"display: inline-block; padding: 10px 20px; font-family: sans-serif; font-size: 16px; color: #ffffff; text-decoration: none; border-radius: 4px; background-color: #1f57b5;\" class=\"button-link\">CLICK HERE.&nbsp;&nbsp;<\/a><\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\"><br><\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">The online store is run by Paladin Sports Limited, they will process your order and have it delivered direct to you.<\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\"><\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">Pre-order items will take approximately 6 weeks from the shop window close date to manufacture, and approximately another week to ship to you.&nbsp;<\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\"><\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">The other items are held in stock and they aim to have these delivered to you within 1-2 business days.<\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\"><\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">If you have a mix of stock and pre order items you will be charged two delivery fees, the stock items will be delivered first and the preorder items will be delivered once they arrive from the manufacturer.<\/p>\n\n<a ses:no-track href=\"https:\/\/assets.hail-cdn.com\/uploads\/2000-constrained-f127b2e7-d097-4081-a5e1-3a79de27b722\" target=\"_blank\" style=\"text-decoration: none; border: none; outline: none;\" class=\"hail-inline\" data-caption=\"\" data-grapher=\"\" data-width=\"1600\" data-height=\"2000\"><figure text-align=\"center\" data-hail-inline-id=\"svVQgDB\" data-hail-inline-type=\"image\" data-hail-width-percentage=\"57.392473118279575\" style=\"text-align: center; margin: 0; padding: 0;\"><div class=\"email-image-wrapper\" style=\"display: inline-block; width: 57%; max-width: