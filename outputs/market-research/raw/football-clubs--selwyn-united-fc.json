 ensure we are able to provide a quality service to the Selwyn community.<\/p>\n\n<p>&nbsp;<br><\/p>","date":"2019-02-27 07:33:32","show_date":false,"location":null,"location_latitude":null,"location_longitude":null,"status":"published","created_date":"2019-02-27 07:33:32","updated_date":"2025-01-15 23:15:10","average_rating":0,"attachments":[],"sender_organisation":null,"attributed_article":null,"blocks":[],"default_description":"SUFC's major partner - Arbor Green...","org_name":"Selwyn United FC","user":{"id":"tuL3dVv","first_name":"Darren","last_name":"Sudlow","avatar_url":"https:\/\/assets.hail-cdn.com\/mV3VzlTKCx9On9Ex7vWddZ2j7645jJsrAXIGajpkDnDFjF8Ws6dKoaCGuj0gnxVHWdlUukag87xHVgpobg5kKRCh5NzUd0JwhE27pCtrqLvx89cIZXb7yRD1Zm5GoWLD","cw_admin":false,"last_active_date":"2026-06-28 21:54:07"},"videos":[],"tags":[{"id":"deh6HEt","name":"Community","description":null},{"id":"0CxDulV","name":"MPL","description":null},{"id":"WgB4HFM","name":"Sponsorship","description":null}],"private_tags":[],"images":[],"hero_image":{"id":"EP4KADW","caption":null,"people":null,"location":null,"location_latitude":null,"location_longitude":null,"date":"2025-01-15 23:14:41","editable":false,"photographer":null,"camera":null,"status":"approved","file_150_square_url":"https:\/\/assets.hail-cdn.com\/uploads\/150x150-fd8c86cd-ab76-4785-bc02-f9ab3d060432","file_500_url":"https:\/\/assets.hail-cdn.com\/uploads\/500-constrained-1f41b8ad-4eda-4f35-b504-e01354434b31","file_500_square_url":"https:\/\/assets.hail-cdn.com\/uploads\/500x500-fe8f3919-5f3e-44ff-9fb1-7d025b9e3025","file_1000_url":"https:\/\/assets.hail-cdn.com\/uploads\/1000-constrained-1971fda5-5258-4aed-be28-44f7d8f4bae2","file_1000_square_url":"https:\/\/assets.hail-cdn.com\/uploads\/1000x1000-3212d883-bcdf-46fb-a6bb-86358d403f36","file_2000_url":"https:\/\/assets.hail-cdn.com\/uploads\/2000-constrained-60d7c61b-60a2-4d00-8b79-fc1f60debd69","file_original_url":"https:\/\/assets.hail-cdn.com\/uploads\/original-b2266d24-43c5-485b-9503-8