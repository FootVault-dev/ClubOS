s:\/\/assets.hail-cdn.com\/uploads\/original-af4aaac0-b377-4142-9eee-f17a133e27b8","original_width":6000,"original_height":4000,"focal_point":{"x":4255,"y":1019},"colour_palette":{"background":{"rgb":{"red":24,"green":27,"blue":42}},"primary":{"rgb":{"red":186,"green":166,"blue":173}},"secondary":{"rgb":{"red":220,"green":167,"blue":90}},"detail":{"rgb":{"red":245,"green":231,"blue":123}}},"tags":[],"private_tags":[],"user":{"id":"gGARcL6","first_name":"Administration","last_name":"Manager","avatar_url":"","cw_admin":false,"last_active_date":"2026-06-30 05:16:24"},"amnesty_expiry":"2025-08-16 01:34:36","created_date":"2025-08-15 01:34:39","average_rating":0,"sender_organisation":null,"attributed_image":null,"noindex":false,"deleted_date":null},"hero_video":null,"url":"https:\/\/hail.to\/selwyn\/article\/GUuvqsO","hail_url":"https:\/\/hail.to\/selwyn\/article\/GUuvqsO","order":null},"title":"Girl's Development Sessions - Term 3 2026"},"depth":1,"parent":12124,"left":42,"right":43}],"association":{"type":"url","entity":"","title":null},"depth":1,"parent":null,"left":29,"right":74},{"id":"E2gv3be","name":"Development, Skill & Talent Centres","type":"folder","in_use":true,"display_homepage":true,"display_magazines":false,"display_gazettes":false,"display_newsletters":false,"display_noticeboards":false,"display_blogs":false,"display_yearbooks":false,"display_articles":false,"ordering_id":23921,"children":[{"id":"jorg1pv","name":"2026 Development, Skill & Talent Centre","type":"link","in_use":true,"display_homepage":true,"display_magazines":true,"display_gazettes":true,"display_newsletters":true,"display_noticeboards":false,"display_blogs":true,"display_yearbooks":true,"display_articles":true,"ordering_id":33762,"association":{"type":"article","entity":{"id":"7AJxIF3","title":"2026 Selwyn Development Centre, Skill Centre and Talent Centre","author":"SUFC","show_author":true,"lead":"Selwyn United Development Centre, Skill Centre &amp; Talent Centre sessions are back for 2026 at Foster Park, Rolleston.","body":"<h3><strong>Selwyn United 7th - 9th Grade Development Centre<\/strong><\/h3>\n\n<p>The Development Centre sessions are designed for players aged 7 years old to 9 years old who want a little extra training each week to improve their technical ability and foster their development.<\/p>\n\n<p style=\"text-align:left;\"><\/p>\n\n<p style=\"text-align:left;\">They are open to any players aged 7 years to 9 years old who want to enhance their skill development, the sessions are fun and inclusive to all. Come and play, learn and excel through football.<\/p>\n\n<p style=\"text-align:left;\"><\/p>\n\n<p style=\"text-align:left;\">If a player has the motivation to learn and be challenged, then these sessions may be just what you are looking for.<\/p>\n\n<p style=\"text-align:left;\"><\/p>\n\n<p style=\"text-align:left;\">The Development Centre program has been designed to provide players with basic football fundamentals that can be practiced in a fun environment. The Development Centre will also act as stepping stone into the Skill Centre, following the same focuses, however, scaled down to suit the age groups.&nbsp;<\/p>\n\n<p style=\"text-align:left;\">Development Centre Focuses:<\/p>\n\n<p style=\"text-align:left;\">\u2022\u2002\u2002\u2002\u2002\u2002Ball Manipulation<\/p>\n\n<p style=\"text-align:left;\">\u2022\u2002\u2002\u2002\u2002\u20021v1 domination<\/p>\n\n<p style=\"text-align:left;\">\u2022\u2002\u2002\u2002\u2002\u20023v3-5v5 conditioned practice<\/p>\n\n<p style=\"text-align:left;\">\u2022\u2002\u2002\u2002\u2002\u2002Small Sided Games<\/p>\n\n<p style=\"text-align:left;\"><\/p>\n\n<p style=\"text-align:left;\">The sessions will be run on Tuesdays &amp; Thursdays 4pm to 5pm. Players can register for just one session or both sessions per week.<\/p>\n\n<h4><strong>Development Centre Costs<\/strong><\/h4>\n\n<p style=\"text-align:left;\">1 session per week $100 per term<\/p>\n\n<p style=\"text-align:left;\">2 sessions per week $200 per term<\/p>\n\n<p style=\"text-align:left;\">To register for these sessions please <a href=\"https:\/\/forms.gle\/ifvqFM2pp2rPvvwH8\"><strong>CLICK HERE<\/strong><\/a><\/p>\n\n<h3><strong>Selwyn United Skill Centre<\/strong><\/h3>\n\n<p>Selwyn United Skill Centre sessions are back for 2026.<\/p>\n\n<p>The Selwyn United Skill Centre is a New Zealand Football licensed Skill Centre programme designed for 10th \u2013 12th Grade players.&nbsp;<\/p>\n\n<p>As a club we are passionate on providing a program that is open to all players, the Selwyn Skill Centre is a program for any player who wants to improve their skills.<\/p>\n\n<p>Our vision is to inspire participation by providing a football environment that is of the highest-quality, fun and inclusive to all regardless of a player\u2019s motivation or ability. There is no one individual more important than another. We are united as a club and as a community, with the purpose of providing opportunities for our community to enjoy, play, learn and excel through football.<\/p>\n\n<p style=\"text-align:left;\">We also see development as something that goes well beyond simply playing the game. \u2018Good People First, Good Players Second\u2019.&nbsp;<\/p>\n\n<p style=\"text-align:left;\">We very firmly believe in developing the person as well as producing the player and having a process that is based around the individual needs of our players and the development of attributes in their game, that will see them develop and succeed in whatever pathway is right for them.<\/p>\n\n<p>The Skill Centre's focus is to provide an environment to develop key fundamentals within a player's skill set, while also creating a fun\/positive culture for players to make a lifelong connection to the game.<\/p>\n\n<h4>Skill Centre Focuses:<\/h4>\n\n<p>- Ball Manipulation<\/p>\n\n<p>- 1v1 domination<\/p>\n\n<p>- 3v3-5v5 conditioned practice<\/p>\n\n<p>- Small Sided Games<\/p>\n\n<p>Players can choose to have one or two sessions per week (in addition to their regular Winter Season club team training session).<\/p>\n\n<h4>Skill Centre Costs:<\/h4>\n\n<ul><li><p>1 session per week $150 per term<\/p><\/li><li><p>2 sessions per week $300 per term<\/p><p><\/p><p style=\"text-align:left;\"><a href=\"https:\/\/forms.gle\/hP52tJQLAaNcgkm86\"><strong>To register your interest in having your daughter or son involved with the SUFC Skill Centre program please click this link<\/strong><\/a><\/p><p style=\"text-align:left;\"><strong><em>Please note that this link IS NOT a registration link. It is simply just registering an interest. Soon after completing the form, you will receive an email with more information.<\/em><\/strong><\/p><\/li><\/ul>\n\n<h4>Training Schedule for Term 1<\/h4>\n\n<p><strong>10th Grade<\/strong><\/p>\n\n<p>Tuesday: 4pm-5pm \u2013 Foster Park turf<\/p>\n\n<p>Thursday: 4pm-5pm \u2013 Foster Park turf<\/p>\n\n<p><strong>11th Grade<\/strong><\/p>\n\n<p>Tuesday: 4pm-5pm \u2013 Foster Park turf<\/p>\n\n<p>Thursday: 4pm-5pm \u2013 Foster Park turf<\/p>\n\n<p><strong>12th Grade<\/strong><\/p>\n\n<p>Tuesday: 4pm-5pm \u2013 Foster Park turf<\/p>\n\n<p>Thursday: 4pm-5pm \u2013 Foster Park turf<\/p>\n\n<h3><strong>Selwyn Talent Centre<\/strong><\/h3>\n\n<p>Selwyn United Talent Centre sessions are back for 2026.&nbsp;<\/p>\n\n<p>The Selwyn United Talent Centre is a New Zealand Football licensed Talent Centre Program for our Colts squads who play in the Canterbury Development Leagues.<\/p>\n\n<h4>Training Schedule for Term 1<\/h4>\n\n<p>13th Grade \u2013 Monday &amp; Tuesday - 5.15pm-6.30pm<\/p>\n\n<p>14th Grade \u2013 Tuesday &amp; Thursday - 5.15pm-6.30pm<\/p>\n\n<p>15th Grade \u2013 Tuesday &amp; Thursday - 5.15pm-6.30pm<\/p>\n\n<p>17th Grade - Monday Foster Park grass, Tuesday &amp; Thursday Foster Park turf 5.15pm - 6.30pm<\/p>\n\n<h4>Talent Centre Costs<\/h4>\n\n<p>$395 per term + compulsory Training Kit-purchased by the player and worn to all training sessions and tournaments, consists of training t shirt, training shorts, pullover, black socks and a bag, approx. cost $235.00 per set.<\/p>\n\n<p><\/p>\n\n<p>To register your interest in having your daughter or son trial for Selwyn Talent Centre please <a href=\"https:\/\/docs.google.com\/forms\/d\/e\/1FAIpQLSe6MHf_NxLghhY7iP0OX1rLMfgFNcm5Hmx6CBXqZUm3niYqkg\/viewform\">CLICK HERE<\/a><\/p>\n\n<p>*Please note that this link is NOT a registration, it is simply just registering an interest. Soon after completing the form, you will receive an email with more information.&nbsp;<br><\/p>\n\n<p>If you have any questions regarding Development Centre, Skill Centre or Talent Centre, please contact Chris Brown <a href=\"mailto:dof@sufc.nz\">dof@sufc.nz<\/a><br><\/p>\n\n<p><br><\/p>","body_mail":"\n        <!--[if (gte mso 9)|(IE)]>\n        <table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" width=\"516\">\n        <tr>\n        <td>\n        <![endif]-->\n        <div style=\"max-width: 516px; margin: 0 auto; box-sizing: border-box; font-family: sans-serif; font-size: 18px; line-height: 1.6; color: #475569;\">\n        <h3 style=\"margin-top: 24px; margin-bottom: 16px; font-size: 20px; line-height: 1.4; font-weight: bold;\"><strong style=\"font-weight: bold;\">Selwyn United 7th - 9th Grade Development Centre<\/strong><\/h3>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">The Development Centre sessions are designed for players aged 7 years old to 9 years old who want a little extra training each week to improve their technical ability and foster their development.<\/p>\n\n<p style=\"text-align:left;margin-top: 0; margin-bottom: 16px; line-height: 1.6;\"><\/p>\n\n<p style=\"text-align:left;margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">They are open to any players aged 7 years to 9 years old who want to enhance their skill development, the sessions are fun and inclusive to all. Come and play, learn and excel through football.<\/p>\n\n<p style=\"text-align:left;margin-top: 0; margin-bottom: 16px; line-height: 1.6;\"><\/p>\n\n<p style=\"text-align:left;margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">If a player has the motivation to learn and be challenged, then these sessions may be just what you are looking for.<\/p>\n\n<p style=\"text-align:left;margin-top: 0; margin-bottom: 16px; line-height: 1.6;\"><\/p>\n\n<p style=\"text-align:left;margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">The Development Centre program has been designed to provide players with basic football fundamentals that can be practiced in a fun environment. The Development Centre will also act as stepping stone into the Skill Centre, following the same focuses, however, scaled down to suit the age groups.&nbsp;<\/p>\n\n<p style=\"text-align:left;margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">Development Centre Focuses:<\/p>\n\n<p style=\"text-align:left;margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">\u2022\u2002\u2002\u2002\u2002\u2002Ball Manipulation<\/p>\n\n<p style=\"text-align:left;margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">\u2022\u2002\u2002\u2002\u2002\u20021v1 domination<\/p>\n\n<p style=\"text-align:left;margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">\u2022\u2002\u2002\u2002\u2002\u20023v3-5v5 conditioned practice<\/p>\n\n<p style=\"text-align:left;margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">\u2022\u2002\u2002\u2002\u2002\u2002Small Sided Games<\/p>\n\n<p style=\"text-align:left;margin-top: 0; margin-bottom: 16px; line-height: 1.6;\"><\/p>\n\n<p style=\"text-align:left;margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">The sessions will be run on Tuesdays &amp; Thursdays 4pm to 5pm. Players can register for just one session or both sessions per week.<\/p>\n\n<h4 style=\"margin-top: 24px; margin-bottom: 16px; font-size: 18px; line-height: 1.4; font-weight: bold;\"><strong style=\"font-weight: bold;\">Development Centre Costs<\/strong><\/h4>\n\n<p style=\"text-align:left;margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">1 session per week $100 per term<\/p>\n\n<p style=\"text-align:left;margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">2 sessions per week $200 per term<\/p>\n\n<p style=\"text-align:left;margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">To register for these sessions please <a ses:no-track href=\"https:\/\/forms.gle\/ifvqFM2pp2rPvvwH8\" style=\"color: #0366d6; text-decoration: underline;\"><strong>CLICK HERE<\/strong><\/a><\/p>\n\n<h3 style=\"margin-top: 24px; margin-bottom: 16px; font-size: 20px; line-height: 1.4; font-weight: bold;\"><strong style=\"font-weight: bold;\">Selwyn United Skill Centre<\/strong><\/h3>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">Selwyn United Skill Centre sessions are back for 2026.<\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">The Selwyn United Skill Centre is a New Zealand Football licensed Skill Centre programme designed for 10th \u2013 12th Grade players.&nbsp;<\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">As a club we are passionate on providing a program that is open to all players, the Selwyn Skill Centre is a program for any player who wants to improve their skills.<\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">Our vision is to inspire participation by providing a football environment that is of the highest-quality, fun and inclusive to all regardless of a player\u2019s motivation or ability. There is no one individual more important than another. We are united as a club and as a community, with the purpose of providing opportunities for our community to enjoy, play, learn and excel through football.<\/p>\n\n<p style=\"text-align:left;margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">We also see development as something that goes well beyond simply playing the game. \u2018Good People First, Good Players Second\u2019.&nbsp;<\/p>\n\n<p style=\"text-align:left;margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">We very firmly believe in developing the person as well as producing the player and having a process that is based around the individual needs of our players and the development of attributes in their game, that will see them develop and succeed in whatever pathway is right for them.<\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">The Skill Centre's focus is to provide an environment to develop key fundamentals within a player's skill set, while also creating a fun\/positive culture for players to make a lifelong connection to the game.<\/p>\n\n<h4 style=\"margin-top: 24px; margin-bottom: 16px; font-size: 18px; line-height: 1.4; font-weight: bold;\">Skill Centre Focuses:<\/h4>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">- Ball Manipulation<\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">- 1v1 domination<\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">- 3v3-5v5 conditioned practice<\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">- Small Sided Games<\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">Players can choose to have one or two sessions per week (in addition to their regular Winter Season club team training session).<\/p>\n\n<h4 style=\"margin-top: 24px; margin-bottom: 16px; font-size: 18px; line-height: 1.4; font-weight: bold;\">Skill Centre Costs:<\/h4>\n\n<ul style=\"margin-top: 0; margin-bottom: 16px; padding-left: 40px;\"><li><p>1 session per week $150 per term<\/p><\/li><li><p>2 sessions per week $300 per term<\/p><p><\/p><p style=\"text-align:left;\"><a ses:no-track href=\"https:\/\/forms.gle\/hP52tJQLAaNcgkm86\"><strong>To register your interest in having your daughter or son involved with the SUFC Skill Centre program please click this link<\/strong><\/a><\/p><p style=\"text-align:left;\"><strong><em>Please note that this link IS NOT a registration link. It is simply just registering an interest. Soon after completing the form, you will receive an email with more information.<\/em><\/strong><\/p><\/li><\/ul>\n\n<h4 style=\"margin-top: 24px; margin-bottom: 16px; font-size: 18px; line-height: 1.4; font-weight: bold;\">Training Schedule for Term 1<\/h4>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\"><strong style=\"font-weight: bold;\">10th Grade<\/strong><\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">Tuesday: 4pm-5pm \u2013 Foster Park turf<\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">Thursday: 4pm-5pm \u2013 Foster Park turf<\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\"><strong style=\"font-weight: bold;\">11th Grade<\/strong><\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">Tuesday: 4pm-5pm \u2013 Foster Park turf<\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">Thursday: 4pm-5pm \u2013 Foster Park turf<\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\"><strong style=\"font-weight: bold;\">12th Grade<\/strong><\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">Tuesday: 4pm-5pm \u2013 Foster Park turf<\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">Thursday: 4pm-5pm \u2013 Foster Park turf<\/p>\n\n<h3 style=\"margin-top: 24px; margin-bottom: 16px; font-size: 20px; line-height: 1.4; font-weight: bold;\"><strong style=\"font-weight: bold;\">Selwyn Talent Centre<\/strong><\/h3>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">Selwyn United Talent Centre sessions are back for 2026.&nbsp;<\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">The Selwyn United Talent Centre is a New Zealand Football licensed Talent Centre Program for our Colts squads who play in the Canterbury Development Leagues.<\/p>\n\n<h4 style=\"margin-top: 24px; margin-bottom: 16px; font-size: 18px; line-height: 1.4; font-weight: bold;\">Training Schedule for Term 1<\/h4>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">13th Grade \u2013 Monday &amp; Tuesday - 5.15pm-6.30pm<\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">14th Grade \u2013 Tuesday &amp; Thursday - 5.15pm-6.30pm<\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">15th Grade \u2013 Tuesday &amp; Thursday - 5.15pm-6.30pm<\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">17th Grade - Monday Foster Park grass, Tuesday &amp; Thursday Foster Park turf 5.15pm - 6.30pm<\/p>\n\n<h4 style=\"margin-top: 24px; margin-bottom: 16px; font-size: 18px; line-height: 1.4; font-weight: bold;\">Talent Centre Costs<\/h4>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">$395 per term + compulsory Training Kit-purchased by the player and worn to all training sessions and tournaments, consists of training t shirt, training shorts, pullover, black socks and a bag, approx. cost $235.00 per set.<\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\"><\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">To register your interest in having your daughter or son trial for Selwyn Talent Centre please <a ses:no-track href=\"https:\/\/docs.google.com\/forms\/d\/e\/1FAIpQLSe6MHf_NxLghhY7iP0OX1rLMfgFNcm5Hmx6CBXqZUm3niYqkg\/viewform\" style=\"color: #0366d6; text-decoration: underline;\">CLICK HERE<\/a><\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">*Please note that this link is NOT a registration, it is simply just registering an interest. Soon after completing the form, you will receive an email with more information.&nbsp;<br><\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">If you have any questions regarding Development Centre, Skill Centre or Talent Centre, please contact Chris Brown <a ses:no-track href=\"mailto:dof@sufc.nz\" style=\"color: #0366d6; text-decoration: underline;\">dof@sufc.nz<\/a><br><\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\"><br><\/p>\n        <\/div>\n        <!--[if (gte mso 9)|(IE)]>\n        <\/td>\n        <\/tr>\n        <\/table>\n        <![endif]-->","date":"2026-01-17 11:00:00","show_date":true,"editable":false,"location":null,"location_latitude":null,"location_longitude":null,"status":"published","user":{"id":"gGARcL6","first_name":"Administration","last_name":"Manager","avatar_url":"","cw_admin":false,"last_active_date":"2026-06-30 05:16:24"},"created_date":"2025-01-20 01:14:46","updated_date":"2026-01-17 22:39:49","average_rating":0,"attachments":[],"sender_organisation":null,"attributed_article":null,"blocks":null,"default_description":"Selwyn United Development Centre, Skill Centre &amp; Talent Centre sessions are back for 2026 at Foster Park, Rolleston....","org_name":"Selwyn United FC","website":true,"shared_to_app":false,"noindex":false,"deleted_date":null,"tags":[{"id":"cYDa1qI","name":"Development","description":null},{"id":"qFtKO5i","name":"Events","description":null},{"id":"oGfeY1H","name":"Girls","description":null},{"id":"7dyJ3es","name":"Junior","description":null},{"id":"ekYOsjz","name":"People","description":null},{"id":"oibWg9P","name":"Programme","description":null}],"private_tags":[],"short_gallery":[],"short_video_gallery":[],"hero_image":{"id":"kHpzm4K","caption":null,"people":null,"location":null,"location_latitude":null,"location_longitude":null,"date":"2022-02-04 06:24:31","editable":false,"photographer":"General Manager","camera":null,"status":"approved","file_150_square_url":"https:\/\/assets.hail-cdn.com\/6QxVh8bUkLiqf5hrc73Bal3puwDSxLJ0VkmrhZ8edOAMHy7oIBYdecnD1833lsSFbWKiM7j8ItIlpUGN3orbBJh4A5iWJpLEa3MwsNjRSIZT9IwjCVCElqI46Zkamuu8","file_500_url":"https:\/\/assets.hail-cdn.com\/LlGHbNPaR4tNIifuFqr5gJ0ueNDCMSpJU7ey39usmzHuNCehkIQLDheczntVFz1pXqaNt6tMw