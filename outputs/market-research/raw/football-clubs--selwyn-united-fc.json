rticle":null,"blocks":null,"default_description":"Looking for some coaching inspiration?...","org_name":"Selwyn United FC","website":false,"shared_to_app":false,"noindex":false,"deleted_date":null,"tags":[],"private_tags":[],"short_gallery":[],"short_video_gallery":[],"hero_image":{"id":"b9gnlOz","caption":null,"people":null,"location":null,"location_latitude":null,"location_longitude":null,"date":"2025-05-22 22:55:59","editable":false,"photographer":null,"camera":null,"status":"approved","file_150_square_url":"https:\/\/assets.hail-cdn.com\/uploads\/150x150-f9a295d3-2f20-47c6-94c2-d5550ffc42f5","file_500_url":"https:\/\/assets.hail-cdn.com\/uploads\/500-constrained-9a9da1a1-4410-471c-ad91-5d2e0102d029","file_500_square_url":"https:\/\/assets.hail-cdn.com\/uploads\/500x500-def2cbd2-7f10-4a5f-8449-b5709593862e","file_1000_url":"https:\/\/assets.hail-cdn.com\/uploads\/1000-constrained-444c225a-e549-4ae7-9870-225e9d9a6871","file_1000_square_url":"https:\/\/assets.hail-cdn.com\/uploads\/1000x1000-450bce85-c149-4158-8473-b2e01a60c311","file_2000_url":"https:\/\/assets.hail-cdn.com\/uploads\/2000-constrained-30c71e75-2d07-40a9-8cf5-1c71f476a00e","file_original_url":"https:\/\/assets.hail-cdn.com\/uploads\/original-0464263f-7ee6-4103-8306-160cb5fcd2a2","original_width":6960,"original_height":4640,"focal_point":{"x":5654,"y":1610},"colour_palette":{"background":{"rgb":{"red":73,"green":79,"blue":67}},"primary":{"rgb":{"red":206,"green":170,"blue":163}},"secondary":{"rgb":{"red":117,"green":162,"blue":93}},"detail":{"rgb":{"red":248,"green":114,"blue":36}}},"tags":[],"private_tags":[],"user":{"id":"gGARcL6","first_name":"Administration","last_name":"Manager","avatar_url":"","cw_admin":false,"last_active_date":"2026-06-30 05:16:24"},"amnesty_expiry":"2025-05-23 22:55:59","created_date":"2025-05-22 22:56:04","average_rating":0,"sender_organisation":null,"attributed_image":null,"noindex":false,"deleted_date":null},"hero_video":null,"url":"https:\/\/hail.to\/selwyn\/article\/PwJaQVT","hail_url":"https:\/\/hail.to\/selwyn\/article\/PwJaQVT","order":null},"title":"Coaches Corner"},"depth":1,"parent":null,"left":85,"right":86},{"id":"aW67ptt","name":"Policies & Procedures","type":"folder","in_use":false,"display_homepage":true,"display_magazines":false,"display_gazettes":false,"display_newsletters":false,"display_noticeboards":false,"display_blogs":false,"display_yearbooks":false,"display_articles":false,"ordering_id":24852,"children":[{"id":"xtZzTg5","name":"2026 Membership Subscription Policy","type":"link","in_use":true,"display_homepage":true,"display_magazines":false,"display_gazettes":false,"display_newsletters":false,"display_noticeboards":false,"display_blogs":false,"display_yearbooks":false,"display_articles":false,"ordering_id":24853,"association":{"type":"article","entity":{"id":"mCG6yYw","title":"2026 Membership &amp; Subscription Policy","author":"Administration Manager","show_author":true,"lead":null,"body":"<h3><strong>Membership<\/strong><\/h3>\n\n<p>Selwyn United FC offers a variety of year-round football options for all players, irrespective of age, aspiration or ability.<\/p>\n\n<p>These range from traditional winter football in the Mainland Football Competition through to our in-house 8th to 10th Grade, Futsal, Summer Football, Holiday programs, and NZF licensed Skill and Talent Centre Programs and other courses.<\/p>\n\n<p>Club Membership of SUFC is gained by registering online via \u2018Sporty\/Friendly Manager\u2019 for the winter football competition and payment of the appropriate subscription. At the board\u2019s discretion, official membership may also be extended to volunteers for specific and significant functions within the club.&nbsp;&nbsp;<\/p>\n\n<p>Any products or programs that also cater for players from other NZF affiliated clubs and\/or sporting codes are offered on a one-off basis and do not require \/ constitute Club Membership.&nbsp;&nbsp;<\/p>\n\n<h3><strong>Subscriptions<\/strong>&nbsp;<\/h3>\n\n<h4>1.&nbsp; Setting of Subscription Values<\/h4>\n\n<p>Membership Subscriptions are revised by the Board annually so that we can continue to provide and improve on the products and value to our membership.<\/p>\n\n<p><\/p>\n\n<p><strong>Our subscriptions for the 2026 season are;<\/strong><\/p>\n\n<p><\/p>\n\n<p>\u00b7&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; First Kicks &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;         $165<\/p>\n\n<p>\u00b7&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 8th to 10th Grade&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &nbsp;&nbsp;&nbsp;&nbsp;       $195<\/p>\n\n<p>\u00b7&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 11th to 19th Grade&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;       $230<\/p>\n\n<p>\u00b7&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Senior Men\u2019s &amp; Women\u2019s aged Under 20yrs&nbsp;$260 <\/p>\n\n<p>         as at 31 December 2025<\/p>\n\n<p>\u00b7&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; All other Seniors (Men &amp; Women)&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; $330<\/p>\n\n<p><\/p>\n\n<p>A Team Rebatescheme is in place for Men\u2019s Masters teams. For teams consisting of more than 16 registered and financial players, for every subsequent registered and paid player, a $10 rebate is due to all team members.<\/p>\n\n<p>E.g. every registered and financial member of a 20 player Men\u2019s Masters team is eligible for a 4x$10 rebate, effectively reducing their annual Subscription to $290.<\/p>\n\n<p><\/p>\n\n<p><strong>Selwyn United FC does not offer a \u2018pay per game\u2019 or \u2018casual player\u2019 option.<\/strong><\/p>\n\n<h4>2.&nbsp; Payment of Subscriptions<\/h4>\n\n<p>All senior subscriptions are due in full by all players by the 27th March 2026 (unless prior payment arrangements have been confirmed by <a>admin@sufc.nz<\/a>) and all junior and youth subscriptions are due in full by all players by the 17th April 2026 (unless prior payment arrangements have been confirmed by <a>admin@sufc.nz<\/a>), a late payment fee of $15 per player will be added to all subscriptions not paid by these dates.<\/p>\n\n<p><\/p>\n\n<p>Selwyn United FC wants to ensure everyone can enjoy football and is able to offer payment plans and assist in legitimate hardship cases. Please apply to the Board in writing (<a>board@sufc.nz<\/a>) for consideration on a case by case basis.&nbsp;<\/p>\n\n<h4>3.&nbsp; Late Payment of Subscriptions<\/h4>\n\n<p>We will enforce a strict <strong>No Pay \u2013 No Play policy<\/strong>. Unless prior arrangements have been made with the Club, payments received after the due date described in (2) above will attract a late payment fee of $15 per player.&nbsp;<\/p>\n\n<h4>4.&nbsp; Early Termination of Membership<\/h4>\n\n<p>If at the start of the season there are insufficient registered &amp; financial players to field a team, the team entry will be withdrawn from the competition and any players not able to be placed in another suitable team will receive a full refund.<\/p>\n\n<p><\/p>\n\n<p>Should a member withdraw from playing or terminate their Club Membership, provided written notice has been given to <a>admin@sufc.nz<\/a> the maximum refund of Membership Subscriptions shall be as follows;<\/p>\n\n<p>&nbsp;<\/p>\n\n<div class=\"table-wrapper\"><table class=\"MsoNormalTable\"><tbody><tr><td colspan=\"1\" rowspan=\"1\"><p>a.<\/p><\/td><td colspan=\"1\" rowspan=\"1\"><p>Within 4 weeks of season start<\/p><\/td><td colspan=\"1\" rowspan=\"1\"><p>Full Subscription refund - less $25 Administration Fee<\/p><p>&nbsp;<\/p><\/td><\/tr><tr><td colspan=\"1\" rowspan=\"1\"><p>b.<\/p><\/td><td colspan=\"1\" rowspan=\"1\"><p>Within 8 weeks of season start<\/p><\/td><td colspan=\"1\" rowspan=\"1\"><p>Half of the Subscription<\/p><\/td><\/tr><tr><td colspan=\"1\" rowspan=\"1\"><p>c.<\/p><\/td><td colspan=\"1\" rowspan=\"1\"><p>After&nbsp; &nbsp;8 weeks of season start<\/p><\/td><td colspan=\"1\" rowspan=\"1\"><p>No Subscription refund applied<\/p><p>&nbsp;<\/p><p>&nbsp;<\/p><\/td><\/tr><\/tbody><\/table><\/div>\n\n<p>&nbsp;<\/p>\n\n<p>Refund of the subscription will be considered from the date the notice is received by the Club rather than the actual date last played.<\/p>\n\n<p>&nbsp;<\/p>\n\n<h4>5.&nbsp; Board Discretion<\/h4>\n\n<p>The Board in its sole discretion may, on a case by case basis:<\/p>\n\n<p>\u00b7&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Consider and approve appropriate discounts.<\/p>\n\n<p>\u00b7&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Require an additional equipment\/uniform bond to be paid.<\/p>\n\n<p>&nbsp;<\/p>\n\n<h4>&nbsp;6.&nbsp;&nbsp;&nbsp;New Players \/ Members<\/h4>\n\n<p>New club members joining the club within 10 weeks of the start of the playing season will be required to pay full club membership - without incurring late payment penalty<\/p>\n\n<p>&nbsp;<\/p>\n\n<p>New playing Club members who join the club after the first 10 weeks of the start of the playing season will be required to pay 50% of the relevant grade Club membership subscription - without incurring late payment penalty.<\/p>\n\n<p><\/p>\n\n<p><\/p>\n\n<p><strong>Selwyn United FC Board<\/strong><\/p>\n\n<p><strong>February 2026<\/strong><\/p>","body_mail":"\n        <!--[if (gte mso 9)|(IE)]>\n        <table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" width=\"516\">\n        <tr>\n        <td>\n        <![endif]-->\n        <div style=\"max-width: 516px; margin: 0 auto; box-sizing: border-box; font-family: sans-serif; font-size: 18px; line-height: 1.6; color: #475569;\">\n        <h3 style=\"margin-top: 24px; margin-bottom: 16px; font-size: 20px; line-height: 1.4; font-weight: bold;\"><strong style=\"font-weight: bold;\">Membership<\/strong><\/h3>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">Selwyn United FC offers a variety of year-round football options for all players, irrespective of age, aspiration or ability.<\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">These range from traditional winter football in the Mainland Football Competition through to our in-house 8th to 10th Grade, Futsal, Summer Football, Holiday programs, and NZF licensed Skill and Talent Centre Programs and other courses.<\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">Club Membership of SUFC is gained by registering online via \u2018Sporty\/Friendly Manager\u2019 for the winter football competition and payment of the appropriate subscription. At the board\u2019s discretion, official membership may also be extended to volunteers for specific and significant functions within the club.&nbsp;&nbsp;<\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">Any products or programs that also cater for players from other NZF affiliated clubs and\/or sporting codes are offered on a one-off basis and do not require \/ constitute Club Membership.&nbsp;&nbsp;<\/p>\n\n<h3 style=\"margin-top: 24px; margin-bottom: 16px; font-size: 20px; line-height: 1.4; font-weight: bold;\"><strong style=\"font-weight: bold;\">Subscriptions<\/strong>&nbsp;<\/h3>\n\n<h4 style=\"margin-top: 24px; margin-bottom: 16px; font-size: 18px; line-height: 1.4; font-weight: bold;\">1.&nbsp; Setting of Subscription Values<\/h4>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">Membership Subscriptions are revised by the Board annually so that we can continue to provide and improve on the products and value to our membership.<\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\"><\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\"><strong style=\"font-weight: bold;\">Our subscriptions for the 2026 season are;<\/strong><\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\"><\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">\u00b7&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; First Kicks &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;         $165<\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">\u00b7&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 8th to 10th Grade&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &nbsp;&nbsp;&nbsp;&nbsp;       $195<\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">\u00b7&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 11th to 19th Grade&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;       $230<\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">\u00b7&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Senior Men\u2019s &amp; Women\u2019s aged Under 20yrs&nbsp;$260 <\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">         as at 31 December 2025<\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">\u00b7&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; All other Seniors (Men &amp; Women)&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; $330<\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\"><\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">A Team Rebatescheme is in place for Men\u2019s Masters teams. For teams consisting of more than 16 registered and financial players, for every subsequent registered and paid player, a $10 rebate is due to all team members.<\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">E.g. every registered and financial member of a 20 player Men\u2019s Masters team is eligible for a 4x$10 rebate, effectively reducing their annual Subscription to $290.<\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\"><\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\"><strong style=\"font-weight: bold;\">Selwyn United FC does not offer a \u2018pay per game\u2019 or \u2018casual player\u2019 option.<\/strong><\/p>\n\n<h4 style=\"margin-top: 24px; margin-bottom: 16px; font-size: 18px; line-height: 1.4; font-weight: bold;\">2.&nbsp; Payment of Subscriptions<\/h4>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">All senior subscriptions are due in full by all players by the 27th March 2026 (unless prior payment arrangements have been confirmed by <a ses:no-track style=\"color: #0366d6; text-decoration: underline;\">admin@sufc.nz<\/a>) and all junior and youth subscriptions are due in full by all players by the 17th April 2026 (unless prior payment arrangements have been confirmed by <a ses:no-track style=\"color: #0366d6; text-decoration: underline;\">admin@sufc.nz<\/a>), a late payment fee of $15 per player will be added to all subscriptions not paid by these dates.<\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\"><\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">Selwyn United FC wants to ensure everyone can enjoy football and is able to offer payment plans and assist in legitimate hardship cases. Please apply to the Board in writing (<a ses:no-track style=\"color: #0366d6; text-decoration: underline;\">board@sufc.nz<\/a>) for consideration on a case by case basis.&nbsp;<\/p>\n\n<h4 style=\"margin-top: 24px; margin-bottom: 16px; font-size: 18px; line-height: 1.4; font-weight: bold;\">3.&nbsp; Late Payment of Subscriptions<\/h4>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">We will enforce a strict <strong style=\"font-weight: bold;\">No Pay \u2013 No Play policy<\/strong>. Unless prior arrangements have been made with the Club, payments received after the due date described in (2) above will attract a late payment fee of $15 per player.&nbsp;<\/p>\n\n<h4 style=\"margin-top: 24px; margin-bottom: 16px; font-size: 18px; line-height: 1.4; font-weight: bold;\">4.&nbsp; Early Termination of Membership<\/h4>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">If at the start of the season there are insufficient registered &amp; financial players to field a team, the team entry will be withdrawn from the competition and any players not able to be placed in another suitable team will receive a full refund.<\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\"><\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">Should a member withdraw from playing or terminate their Club Membership, provided written notice has been given to <a ses:no-track style=\"color: #0366d6; text-decoration: underline;\">admin@sufc.nz<\/a> the maximum refund of Membership Subscriptions shall be as follows;<\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">&nbsp;<\/p>\n\n<table class=\"MsoNormalTable\" cellpadding=\"8\" cellspacing=\"0\" border=\"0\" style=\"width: 100%; max-width: 516px; margin: 0 auto 20px auto; border-collapse: collapse; table-layout: fixed;\" width=\"100%\"><tbody><tr style=\"background-color: #ffffff;\"><td colspan=\"1\" rowspan=\"1\" style=\"text-align: left; padding: 8px; border: 1px solid #ddd; word-break: break-word; width: 33.333333333333%; vertical-align: top;\"><p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">a.<\/p><\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: left; padding: 8px; border: 1px solid #ddd; word-break: break-word; width: 33.333333333333%; vertical-align: top;\"><p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">Within 4 weeks of season start<\/p><\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: left; padding: 8px; border: 1px solid #ddd; word-break: break-word; width: 33.333333333333%; vertical-align: top;\"><p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">Full Subscription refund - less $25 Administration Fee<\/p><p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">&nbsp;<\/p><\/td><\/tr><tr style=\"background-color: #ffffff;\"><td colspan=\"1\" rowspan=\"1\" style=\"text-align: left; padding: 8px; border: 1px solid #ddd; word-break: break-word; width: 33.333333333333%; vertical-align: top;\"><p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">b.<\/p><\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: left; padding: 8px; border: 1px solid #ddd; word-break: break-word; width: 33.333333333333%; vertical-align: top;\"><p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">Within 8 weeks of season start<\/p><\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: left; padding: 8px; border: 1px solid #ddd; word-break: break-word; width: 33.333333333333%; vertical-align: top;\"><p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">Half of the Subscription<\/p><\/td><\/tr><tr style=\"background-color: #ffffff;\"><td colspan=\"1\" rowspan=\"1\" style=\"text-align: left; padding: 8px; border: 1px solid #ddd; word-break: break-word; width: 33.333333333333%; vertical-align: top;\"><p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">c.<\/p><\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: left; padding: 8px; border: 1px solid #ddd; word-break: break-word; width: 33.333333333333%; vertical-align: top;\"><p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">After&nbsp; &nbsp;8 weeks of season start<\/p><\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: left; padding: 8px; border: 1px solid #ddd; word-break: break-word; width: 33.333333333333%; vertical-align: top;\"><p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">No Subscription refund applied<\/p><p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">&nbsp;<\/p><p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">&nbsp;<\/p><\/td><\/tr><\/tbody><\/table>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">&nbsp;<\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">Refund of the subscription will be considered from the date the notice is received by the Club rather than the actual date last played.<\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">&nbsp;<\/p>\n\n<h4 style=\"margin-top: 24px; margin-bottom: 16px; font-size: 18px; line-height: 1.4; font-weight: bold;\">5.&nbsp; Board Discretion<\/h4>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">The Board in its sole discretion may, on a case by case basis:<\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">\u00b7&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Consider and approve appropriate discounts.<\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">\u00b7&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Require an additional equipment\/uniform bond to be paid.<\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">&nbsp;<\/p>\n\n<h4 style=\"margin-top: 24px; margin-bottom: 16px; font-size: 18px; line-height: 1.4; font-weight: bold;\">&nbsp;6.&nbsp;&nbsp;&nbsp;New Players \/ Members<\/h4>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">New club members joining the club within 10 weeks of the start of the playing season will be required to pay full club membership - without incurring late payment penalty<\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">&nbsp;<\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">New playing Club members who join the club after the first 10 weeks of the start of the playing season will be required to pay 50% of the relevant grade Club membership subscription - without incurring late payment penalty.<\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\"><\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\"><\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\"><strong style=\"font-weight: bold;\">Selwyn United FC Board<\/strong><\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\"><strong style=\"font-weight: bold;\">February 2026<\/strong><\/p>\n        <\/div>\n        <!--[if (gte mso 9)|(IE)]>\n        <\/td>\n        <\/tr>\n        <\/table>\n        <![endif]-->","date":"2026-02-04 06:20:26","show_date":true,"editable":false,"location":null,"location_latitude":null,"location_longitude":null,"status":"published","user":{"id":"gGARcL6","first_name":"Administration","last_name":"Manager","avatar_url":"","cw_admin":false,"last_active_date":"2026-06-30 05:16:24"},"created_date":"2026-02-04 06:20:26","updated_date":"2026-02-04 06:29:05","average_rating":0,"attachments":[],"sender_organisation":null,"attributed_article":null,"blocks":null,"default_description":"2026 Membership &amp; Subscription Policy","org_name":"Selwyn United FC","website":false,"shared_to_app":false,"noindex":false,"deleted_date":null,"tags":[],"private_tags":[],"short_gallery":[],"short_video_gallery":[],"hero_image":{"id":"VKEjpHJ","caption":null,"people":null,"location":null,"location_latitude":null,"location_longitude":null,"date":"2025-06-10 03:46:57","editable":false,"photographer":null,"camera":null,"status":"approved","file_150_square_url":"https:\/\/assets.hail-cdn.com\/uploads\/150x150-2e9bc178-7b46-4798-894d-de7419bd7538","file_500_url":"https:\/\/assets.hail-cdn.com\/uploads\/500-constrained-7ad7a548-9925-41f8-97b4-223f3a589f33","file_500_square_url":"https:\/\/assets.hail-cdn.com\/uploads\/500x500-7f8e75ed-9383-4409-b0a9-5f92282d70d6","file_1000_url":"https:\/\/assets.hail-cdn.com\/uploads\/1000-constrained-b72fcc22-61ef-4c98-83be-1c1e9caf17f6","file_1000_square_url":"https:\/\/assets.hail-cdn.com\/uploads\/1000x1000-aefffb9f-3a6e-4851-876c-81e6f196befe","file_2000_url":"https:\/\/assets.hail-cdn.com\/uploads\/2000-constrained-4c7a1a3b-d616-40db-b6ab-b4ac344b65ed","file_original_url":"https:\/\/assets.hail-cdn.com\/uploads\/original-50b8ed25-8876-414c-bea9-5aaca470b594","original_width":1080,"original_height":1080,"focal_point":null,"colour_palette":{"background":{"rgb":{"red":194,"green":208,"blue":133}},"primary":{"rgb":{"red":113,"green":128,"blue":51}},"secondary":{"rgb":{"red":54,"green":57,"blue":31}},"detail":{"rgb":{"red":120,"green":118,"blue":124}}},"tags":[],"private_tags":[],"user":{"id":"gGARcL6","first_name":"Administration","last_name":"Manager","avatar_url":"","cw_admin":false,"last_active_date":"2026-06-30 05:16:24"},"amnesty_expiry":"2025-06-11 03:46:57","created_date":"2025-06-10 03:47:00","average_rating":0,"sender_organisation":null,"attributed_image":null,"noindex":false,"deleted_date":null},"hero_video":null,"url":"https:\/\/hail.to\/selwyn\/article\/mCG6yYw","hail_url":"https:\/\/hail.to\/selwyn\/article\/mCG6yYw","order":null},"title":"2026 Membership &amp; Subscription Policy"},"depth":1,"parent":24852,"left":88,"right":89},{"id":"e6yk4Xe","name":"New Zeland Football Code of Conduct","type":"link","in_use":true,"display_homepage":true,"display_magazines":false,"display_gazettes":false,"display_newsletters":false,"display_noticeboards":false,"display_blogs":false,"display_yearbooks":false,"display_articles":false,"ordering_id":24927,"association":{"type":"article","entity":{"id":"Na6GKH8","title":"New Zealand Football Code of Conduct","author":"Administration Manager","show_author":true,"lead":"All football players in New Zealand are governed by the N Z Football Code of Conduct","body":"<h4><strong>New Zealand Football Code of Conduct<\/strong><\/h4>\n\n<p><strong>Explanatory Foreword<\/strong><\/p>\n\n<p>The purpose of this Code of Conduct is to encourage fair, ethical treatment of all persons and organisations that come under the umbrella of New Zealand Football (NZF). Obviously, some sections of the Code will be more applicable to some persons and groups than others.<\/p>\n\n<p>All persons will agree to abide by the NZF Code of Conduct and acknowledge that any breach of the Code of Conduct, or any part of it, may result in disciplinary action under the NZF Constitution, Regulations and Policies.<\/p>\n\n<p><\/p>\n\n<p>The following Code of Conduct applies to all NZF members and persons participating in NZF activities.<\/p>\n\n<p><\/p>\n\n<p>As a NZF member and\/or participant you should meet the following requirements with regard to your conduct during any NZF sanctioned activity:<\/p>\n\n<ul><li><p>Respect the rights, dignity and worth of others.<\/p><\/li><li><p>Be fair, considerate and honest in all dealings with others.<\/p><\/li><li><p>Be professional in, and accept responsibility for, your actions.<\/p><\/li><li><p>Make a commitment to providing quality service and performance.<\/p><\/li><li><p>Be aware of, and maintain, an uncompromising adherence to, standards, rules, regulations and policies.<\/p><\/li><li><p>Operate within the Constitution, Regulations, Policies and Procedures of NZF and FIFA.<\/p><\/li><li><p>Understand the possible consequences of breaching the NZF Code of Conduct.<\/p><\/li><li><p>Immediately report any breaches of NZF members to the appropriate authority.<\/p><\/li><li><p>Comply with any and all applicable national or local legislation.<\/p><\/li><li><p>Refrain from any form of abuse towards others.<\/p><\/li><li><p>Refrain from using any obscene language.<\/p><\/li><li><p>Refrain from any form of harassment towards others.<\/p><\/li><li><p>Refrain from any form of discrimination towards others.<\/p><\/li><li><p>Refrain from any form of victimisation towards others.<\/p><\/li><li><p>Reject corruption, drugs, racism, violence and other dangers to our sport.<\/p><\/li><li><p>Promote the interests of football.<\/p><\/li><li><p>Provide a safe environment for the conduct of activity in accordance with relevant NZF policy.<\/p><\/li><li><p>Show concern and caution towards others who may be sick or injured.<\/p><\/li><li><p>Be a positive role model.<\/p><\/li><li><p>Do not provide comment to any media, or publish any comment (including on any website), on behalf of New Zealand Football or its Federations.<\/p><\/li><li><p>Do not speak to any media in a negative way, or publish any negative comment (including on any website) regarding New Zealand Football or any of its Federations.<\/p><\/li><li><p>Never act in any way that may bring disrepute or disgrace to NZF members, its stakeholders and\/or its sponsors, potential sponsors and\/or partners.<\/p><\/li><li><p>Do not participate (or benefit from assisting others involved) in sports betting or gambling activity associated with football matches and\/or football results in which you are participating or have been directly involved in.<\/p><\/li><\/ul>\n\n<p>New Zealand Football expects all members, supporters, advisors, staff and associates of NZF to abide by a Code of Conduct that upholds the principles and values of the organisation and the NZF Member Protection Policy. Members should recognise that at all times, they have a duty of care to all NZF members.<\/p>\n\n<p>In addition a Team Manager will:<\/p>\n\n<ul><li><p>Be responsible for the overall welfare and well being of team members and officials when travelling with a team.<\/p><\/li><li><p>Maintain a \u2018duty of care\u2019 towards team members and be accountable for the management of the team.<\/p><\/li><li><p>Have a sound working knowledge of NZF Constitution, Regulations and Policies, and ensure that the conduct of the affairs of the team is in accordance with these and or any other policies and guidelines determined by NZF.<\/p><\/li><li><p>Foster a collaborative approach to the management of the team. Referee will:<\/p><\/li><li><p>Officiate matches in a fair, safe manner that ensures spectator enjoyment and player safety.<\/p><\/li><li><p>Know the Laws of the Game and their interpretations thoroughly.<\/p><\/li><li><p>Condemn unsporting behaviour and promote respect for all opponents. <\/p><\/li><li><p>Be a good sport.<\/p><\/li><li><p>Keep up to date with the latest trends in officiating.<\/p><\/li><li><p>Give all people a \u2018fair go\u2019 regardless of their gender, ability, cultural background or religion.<\/p><\/li><li><p>Maintain physical fitness for peak performance.<\/p><\/li><li><p>Keep all appointments assigned to and accepted by them.<\/p><\/li><li><p>Conduct themselves in a way that is ethically and morally beyond reproach.<\/p><\/li><li><p>Support fellow officials.<\/p><\/li><li><p>Grant players and coaches dignity and self respect.<\/p><p><\/p><\/li><\/ul>\n\n<h4>Member1, Administrator2, Associate3 will:<\/h4>\n\n<p><\/p>\n\n<p>1 A Member shall include a club member, whether active or social, or life member of any affiliated club, organisation or Federation.<\/p>\n\n<p>2 An Administrator shall include any person who is in an elected or appointed administrative capacity, whether paid or a volunteer, at an affiliated football club, affiliated organisation or Federation.<\/p>\n\n<p>3 An Associate shall include any person so determined by the Board of NZF.<\/p>\n\n<ul><li><p>Encourage their members and spectators (as appropriate) to abide by the Code of Conduct and take reasonable steps to ensure such compliance.<\/p><\/li><li><p>Be fair, considerate and honest with others.<\/p><\/li><li><p>Be professional in all actions.<\/p><\/li><li><p>Ensure language, presentation, manner and punctuality reflect high standards.<\/p><\/li><li><p>Resolve conflicts fairly and promptly through established procedures.<\/p><\/li><li><p>Maintain strict impartiality.<\/p><\/li><li><p>Maintain a safe environment for others.<\/p><p><\/p><\/li><\/ul>\n\n<h4>Coach will:<\/h4>\n\n<p>Respect the rights, dignity and worth of every individual player as a human being and:<\/p>\n\n<ul><li><p>Treat everyone equally regardless of gender, disability, ethnicity or religion.<\/p><\/li><li><p>Respect the talent, developmental stage and goals of each player in order to help each player reach their full potential.<\/p><\/li><li><p>Maintain high standards of integrity.<\/p><\/li><li><p>Operate within the rules of football and in the spirit of fair play, while encouraging players to do the same.<\/p><\/li><li><p>Advocate a sporting environment free of drugs and other performance enhancing substances within the guidelines of the New Zealand Sports Drug Agency.<\/p><\/li><li><p>Not disclose any confidential information relating to their players without written prior consent.<\/p><p><\/p><\/li><\/ul>\n\n<p>Be a positive role model for the sport and the players and act in a way that projects a positive image of coaching viz:<\/p>\n\n<ul><li><p>Provide all players with the equal attention and opportunities they deserve.<\/p><\/li><li><p>Ensure the time spent with their player(s) is a positive experience.<\/p><\/li><li><p>Be fair, considerate and honest with players.<\/p><\/li><li><p>Encourage and promote a healthy lifestyle \u2013 refrain from smoking, drinking alcohol and engaging in poor lifestyle choices around players. Show professional responsibility:<\/p><\/li><li><p>Display high standards in language, manner, punctuality, preparation and presentation.<\/p><\/li><li><p>Display control, courtesy, respect, honesty, dignity and professionalism to all involved within the sphere of sport - this includes opponents, coaches, officials, administrators, the media, parents and spectators.<\/p><\/li><li><p>Encourage their players to demonstrate the same qualities.<\/p><\/li><li><p>Be professional and accept responsibility for their actions.<\/p><\/li><li><p>Refrain from initiating a relationship with a player and also discourage any attempt by a player to initiate a sexual relationship with them, explaining the ethical basis of the refusal.<\/p><\/li><li><p>Accurately represent personal coaching qualifications, experience, competence and affiliations.<\/p><\/li><li><p>Refrain from criticism of other coaches. Make a commitment to providing a quality service to their players:<\/p><\/li><li><p>Seek continual improvement through ongoing coach education and other personal and professional development opportunities.<\/p><\/li><li><p>Provide players with planned and structured training programmes appropriate to their needs and goals.<\/p><\/li><li><p>Seek advice and assistance from professionals when additional expertise is required.<\/p><\/li><li><p>Maintain appropriate records.<\/p><p><\/p><\/li><\/ul>\n\n<p>Provide a safe environment for training and competition:<\/p>\n\n<ul><li><p>Adopt appropriate risk management strategies to ensure that the training and\/or competition environment is safe.<\/p><\/li><li><p>Ensure equipment and facilities meet safety standards.<\/p><\/li><li><p>Ensure equipment, rules, training and the environment are appropriate for the age, physical and emotional maturity, experience and ability of the players.<\/p><\/li><li><p>Show concern and caution toward sick and injured players.<\/p><\/li><li><p>Allow further participation in training and competition only when appropriate.<\/p><\/li><li><p>Encourage players to seek medical advice when required.<\/p><\/li><li><p>Provide a modified training programme where appropriate. Maintain the same interest and support toward sick and injured players.<\/p><p><\/p><\/li><\/ul>\n\n<p>Protect players from any form of personal abuse:<\/p>\n\n<ul><li><p>Refrain from any form of verbal, physical and emotional abuse towards players.<\/p><\/li><li><p>Refrain from any form of sexual and racial harassment, racial vilification and harassment on the grounds of disability.<\/p><\/li><li><p>Ensure that any physical contact with players is appropriate to the situation and necessary for the player's skill development.<\/p><\/li><li><p>Be alert to any forms of abuse directed towards players from other sources while in their care.<\/p><p><\/p><\/li><\/ul>\n\n<h4>Player will:<\/h4>\n\n<ul><li><p>Play to win but play fair.<\/p><\/li><li><p>Never argue with or verbally abuse an official; observe the Laws of the Game.<\/p><\/li><li><p>Accept defeat with dignity.<\/p><\/li><li><p>Conduct themselves in a sportsman-like manner and respect fellow players, coaches, managers and referees and the achievement of opponents.<\/p><\/li><li><p>Not bully or take an unfair advantage of another competitor.<\/p><\/li><li><p>Cooperate with their coach, manager, team mates and opponents.<\/p><p><\/p><\/li><\/ul>\n\n<p>In addition, Players in NZF teams will:<\/p>\n\n<ul><li><p>Refrain from possessing and\/or consuming prohibited substances while in NZF camps or on tours.<\/p><\/li><li><p>Not consume or purchase alcohol and tobacco while in NZF camps or on tours without the agreement of the Team Manager and Head Coach.<\/p><\/li><li><p>Comply with training, competition, curfew and behaviour requirements, directed by NZF, while in camp or on tours.<\/p><p><\/p><\/li><\/ul>\n\n<h4>Parent\/Guardian will:<\/h4>\n\n<ul><li><p>Agree to abide by the Code of Conduct.<\/p><\/li><li><p>Remember that children participate in sport for their enjoyment, not the parents.<\/p><\/li><li><p>Encourage children to participate and not force them.<\/p><\/li><li><p>Focus on the child\u2019s efforts and performance rather than winning or losing.<\/p><\/li><li><p>Encourage children always to compete according to the rules and to settle disagreements without resorting to hostility or violence.<\/p><\/li><li><p>Never ridicule or yell at a child for making a mistake or losing a competition.<\/p><\/li><li><p>Remember that children learn best by example.<\/p><\/li><li><p>Support all efforts to remove verbal and physical abuse from sporting activities.<\/p><\/li><li><p>Respect officials\u2019 decisions and teach children to do likewise.<\/p><\/li><li><p>Show appreciation for coaches, officials and administrators.<\/p><p><\/p><\/li><\/ul>\n\n<p>New Zealand Football expects all Federations, clubs, organisations, employees, members, referees, administrators, associates, coaches, players, volunteers and parents or guardians to understand the possible consequences of breaching the Code of Conduct and ensure that they abide by the Code.<\/p>\n\n<p>Any serious breaches of this Code of Conduct or persistent violations of any aspect of the Code of Conduct, by any of the above may result in any of the following being imposed:<\/p>\n\n<p>\u2022 Suspension<\/p>\n\n<p>\u2022 Good behaviour bond<\/p>\n\n<p>\u2022 Fines<\/p>\n\n<p>\u2022 Loss of competition points<\/p>\n\n<p>\u2022 Loss of match<\/p>\n\n<h4>Acknowledgements:<\/h4>\n\n<p>FIFA<\/p>\n\n<p>Football Federation Australia<\/p>\n\n<p>SPARC<\/p>\n\n<p>Swimming NZ<\/p>\n\n<p>United States Football Federation<\/p>","body_mail":"\n        <!--[if (gte mso 9)|(IE)]>\n        <table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" width=\"516\">\n        <tr>\n        <td>\n        <![endif]-->\n        <div style=\"max-width: 516px; margin: 0 auto; box-sizing: border-box; font-family: sans-serif; font-size: 18px; line-height: 1.6; color: #475569;\">\n        <h4 style=\"margin-top: 24px; margin-bottom: 16px; font-size: 18px; line-height: 1.4; font-weight: bold;\"><strong style=\"font-weight: bold;\">New Zealand Football Code of Conduct<\/strong><\/h4>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\"><strong style=\"font-weight: bold;\">Explanatory Foreword<\/strong><\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">The purpose of this Code of Conduct is to encourage fair, ethical treatment of all persons and organisations that come under the umbrella of New Zealand Football (NZF). Obviously, some sections of the Code will be more applicable to some persons and groups than others.<\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">All persons will agree to abide by the NZF Code of Conduct and acknowledge that any breach of the Code of Conduct, or any part of it, may result in disciplinary action under the NZF Constitution, Regulations and Policies.<\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\"><\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">The following Code of Conduct applies to all NZF members and persons participating in NZF activities.<\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\"><\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">As a NZF member and\/or participant you should meet the following requirements with regard to your conduct during any NZF sanctioned activity:<\/p>\n\n<ul style=\"margin-top: 0; margin-bottom: 16px; padding-left: 40px;\"><li><p>Respect the rights, dignity and worth of others.<\/p><\/li><li><p>Be fair, considerate and honest in all dealings with others.<\/p><\/li><li><p>Be professional in, and accept responsibility for, your actions.<\/p><\/li><li><p>Make a commitment to providing quality service and performance.<\/p><\/li><li><p>Be aware of, and maintain, an uncompromising adherence to, standards, rules, regulations and policies.<\/p><\/li><li><p>Operate within the Constitution, Regulations, Policies and Procedures of NZF and FIFA.<\/p><\/li><li><p>Understand the possible consequences of breaching the NZF Code of Conduct.<\/p><\/li><li><p>Immediately report any breaches of NZF members to the appropriate authority.<\/p><\/li><li><p>Comply with any and all applicable national or local legislation.<\/p><\/li><li><p>Refrain from any form of abuse towards others.<\/p><\/li><li><p>Refrain from using any obscene language.<\/p><\/li><li><p>Refrain from any form of harassment towards others.<\/p><\/li><li><p>Refrain from any form of discrimination towards others.<\/p><\/li><li><p>Refrain from any form of victimisation towards others.<\/p><\/li><li><p>Reject corruption, drugs, racism, violence and other dangers to our sport.<\/p><\/li><li><p>Promote the interests of football.<\/p><\/li><li><p>Provide a safe environment for the conduct of activity in accordance with relevant NZF policy.<\/p><\/li><li><p>Show concern and caution towards others who may be sick or injured.<\/p><\/li><li><p>Be a positive role model.<\/p><\/li><li><p>Do not provide comment to any media, or publish any comment (including on any website), on behalf of New Zealand Football or its Federations.<\/p><\/li><li><p>Do not speak to any media in a negative way, or publish any negative comment (including on any website) regarding New Zealand Football or any of its Federations.<\/p><\/li><li><p>Never act in any way that may bring disrepute or disgrace to NZF members, its stakeholders and\/or its sponsors, potential sponsors and\/or partners.<\/p><\/li><li><p>Do not participate (or benefit from assisting others involved) in sports betting or gambling activity associated with football matches and\/or football results in which you are participating or have been directly involved in.<\/p><\/li><\/ul>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">New Zealand Football expects all members, supporters, advisors, staff and associates of NZF to abide by a Code of Conduct that upholds the principles and values of the organisation and the NZF Member Protection Policy. Members should recognise that at all times, they have a duty of care to all NZF members.<\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">In addition a Team Manager will:<\/p>\n\n<ul style=\"margin-top: 0; margin-bottom: 16px; padding-left: 40px;\"><li><p>Be responsible for the overall welfare and well being of team members and officials when travelling with a team.<\/p><\/li><li><p>Maintain a \u2018duty of care\u2019 towards team members and be accountable for the management of the team.<\/p><\/li><li><p>Have a sound working knowledge of NZF Constitution, Regulations and Policies, and ensure that the conduct of the affairs of the team is in accordance with these and or any other policies and guidelines determined by NZF.<\/p><\/li><li><p>Foster a collaborative approach to the management of the team. Referee will:<\/p><\/li><li><p>Officiate matches in a fair, safe manner that ensures spectator enjoyment and player safety.<\/p><\/li><li><p>Know the Laws of the Game and their interpretations thoroughly.<\/p><\/li><li><p>Condemn unsporting behaviour and promote respect for all opponents. <\/p><\/li><li><p>Be a good sport.<\/p><\/li><li><p>Keep up to date with the latest trends in officiating.<\/p><\/li><li><p>Give all people a \u2018fair go\u2019 regardless of their gender, ability, cultural background or religion.<\/p><\/li><li><p>Maintain physical fitness for peak performance.<\/p><\/li><li><p>Keep all appointments assigned to and accepted by them.<\/p><\/li><li><p>Conduct themselves in a way that is ethically and morally beyond reproach.<\/p><\/li><li><p>Support fellow officials.<\/p><\/li><li><p>Grant players and coaches dignity and self respect.<\/p><p><\/p><\/li><\/ul>\n\n<h4 style=\"margin-top: 24px; margin-bottom: 16px; font-size: 18px; line-height: 1.4; font-weight: bold;\">Member1, Administrator2, Associate3 will:<\/h4>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\"><\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">1 A Member shall include a club member, whether active or social, or life member of any affiliated club, organisation or Federation.<\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">2 An Administrator shall include any person who is in an elected or appointed administrative capacity, whether paid or a volunteer, at an affiliated football club, affiliated organisation or Federation.<\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">3 An Associate shall include any person so determined by the Board of NZF.<\/p>\n\n<ul style=\"margin-top: 0; margin-bottom: 16px; padding-left: 40px;\"><li><p>Encourage their members and spectators (as appropriate) to abide by the Code of Conduct and take reasonable steps to ensure such compliance.<\/p><\/li><li><p>Be fair, considerate and honest with others.<\/p><\/li><li><p>Be professional in all actions.<\/p><\/li><li><p>Ensure language, presentation, manner and punctuality reflect high standards.<\/p><\/li><li><p>Resolve conflicts fairly and promptly through established procedures.<\/p><\/li><li><p>Maintain strict impartiality.<\/p><\/li><li><p>Maintain a safe environment for others.<\/p><p><\/p><\/li><\/ul>\n\n<h4 style=\"margin-top: 24px; margin-bottom: 16px; font-size: 18px; line-height: 1.4; font-weight: bold;\">Coach will:<\/h4>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">Respect the rights, dignity and worth of every individual player as a human being and:<\/p>\n\n<ul style=\"margin-top: 0; margin-bottom: 16px; padding-left: 40px;\"><li><p>Treat everyone equally regardless of gender, disability, ethnicity or religion.<\/p><\/li><li><p>Respect the talent, developmental stage and goals of each player in order to help each player reach their full potential.<\/p><\/li><li><p>Maintain high standards of integrity.<\/p><\/li><li><p>Operate within the rules of football and in the spirit of fair play, while encouraging players to do the same.<\/p><\/li><li><p>Advocate a sporting environment free of drugs and other performance enhancing substances within the guidelines of the New Zealand Sports Drug Agency.<\/p><\/li><li><p>Not disclose any confidential information relating to their players without written prior consent.<\/p><p><\/p><\/li><\/ul>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">Be a positive role model for the sport and the players and act in a way that projects a positive image of coaching viz:<\/p>\n\n<ul style=\"margin-top: 0; margin-bottom: 16px; padding-left: 40px;\"><li><p>Provide all players with the equal attention and opportunities they deserve.<\/p><\/li><li><p>Ensure the time spent with their player(s) is a positive experience.<\/p><\/li><li><p>Be fair, considerate and honest with players.<\/p><\/li><li><p>Encourage and promote a healthy lifestyle \u2013 refrain from smoking, drinking alcohol and engaging in poor lifestyle choices around players. Show professional responsibility:<\/p><\/li><li><p>Display high standards in language, manner, punctuality, preparation and presentation.<\/p><\/li><li><p>Display control, courtesy, respect, honesty, dignity and professionalism to all involved within the sphere of sport - this includes opponents, coaches, officials, administrators, the media, parents and spectators.<\/p><\/li><li><p>Encourage their players to demonstrate the same qualities.<\/p><\/li><li><p>Be professional and accept responsibility for their actions.<\/p><\/li><li><p>Refrain from initiating a relationship with a player and also discourage any attempt by a player to initiate a sexual relationship with them, explaining the ethical basis of the refusal.<\/p><\/li><li><p>Accurately represent personal coaching qualifications, experience, competence and affiliations.<\/p><\/li><li><p>Refrain from criticism of other coaches. Make a commitment to providing a quality service to their players:<\/p><\/li><li><p>Seek continual improvement through ongoing coach education and other personal and professional development opportunities.<\/p><\/li><li><p>Provide players with planned and structured training programmes appropriate to their needs and goals.<\/p><\/li><li><p>Seek advice and assistance from professionals when additional expertise is required.<\/p><\/li><li><p>Maintain appropriate records.<\/p><p><\/p><\/li><\/ul>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">Provide a safe environment for training and competition:<\/p>\n\n<ul style=\"margin-top: 0; margin-bottom: 16px; padding-left: 40px;\"><li><p>Adopt appropriate risk management strategies to ensure that the training and\/or competition environment is safe.<\/p><\/li><li><p>Ensure equipment and facilities meet safety standards.<\/p><\/li><li><p>Ensure equipment, rules, training and the environment are appropriate for the age, physical and emotional maturity, experience and ability of the players.<\/p><\/li><li><p>Show concern and caution toward sick and injured players.<\/p><\/li><li><p>Allow further participation in training and competition only when appropriate.<\/p><\/li><li><p>Encourage players to seek medical advice when required.<\/p><\/li><li><p>Provide a modified training programme where appropriate. Maintain the same interest and support toward sick and injured players.<\/p><p><\/p><\/li><\/ul>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">Protect players from any form of personal abuse:<\/p>\n\n<ul style=\"margin-top: 0; margin-bottom: 16px; padding-left: 40px;\"><li><p>Refrain from any form of verbal, physical and emotional abuse towards players.<\/p><\/li><li><p>Refrain from any form of sexual and racial harassment, racial vilification and harassment on the grounds of disability.<\/p><\/li><li><p>Ensure that any physical contact with players is appropriate to the situation and necessary for the player's skill development.<\/p><\/li><li><p>Be alert to any forms of abuse directed towards players from other sources while in their care.<\/p><p><\/p><\/li><\/ul>\n\n<h4 style=\"margin-top: 24px; margin-bottom: 16px; font-size: 18px; line-height: 1.4; font-weight: bold;\">Player will:<\/h4>\n\n<ul style=\"margin-top: 0; margin-bottom: 16px; padding-left: 40px;\"><li><p>Play to win but play fair.<\/p><\/li><li><p>Never argue with or verbally abuse an official; observe the Laws of the Game.<\/p><\/li><li><p>Accept defeat with dignity.<\/p><\/li><li><p>Conduct themselves in a sportsman-like manner and respect fellow players, coaches, managers and referees and the achievement of opponents.<\/p><\/li><li><p>Not bully or take an unfair advantage of another competitor.<\/p><\/li><li><p>Cooperate with their coach, manager, team mates and opponents.<\/p><p><\/p><\/li><\/ul>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">In addition, Players in NZF teams will:<\/p>\n\n<ul style=\"margin-top: 0; margin-bottom: 16px; padding-left: 40px;\"><li><p>Refrain from possessing and\/or consuming prohibited substances while in NZF camps or on tours.<\/p><\/li><li><p>Not consume or purchase alcohol and tobacco while in NZF camps or on tours without the agreement of the Team Manager and Head Coach.<\/p><\/li><li><p>Comply with training, competition, curfew and behaviour requirements, directed by NZF, while in camp or on tours.<\/p><p><\/p><\/li><\/ul>\n\n<h4 style=\"margin-top: 24px; margin-bottom: 16px; font-size: 18px; line-height: 1.4; font-weight: bold;\">Parent\/Guardian will:<\/h4>\n\n<ul style=\"margin-top: 0; margin-bottom: 16px; padding-left: 40px;\"><li><p>Agree to abide by the Code of Conduct.<\/p><\/li><li><p>Remember that children participate in sport for their enjoyment, not the parents.<\/p><\/li><li><p>Encourage children to participate and not force them.<\/p><\/li><li><p>Focus on the child\u2019s efforts and performance rather than winning or losing.<\/p><\/li><li><p>Encourage children always to compete according to the rules and to settle disagreements without resorting to hostility or violence.<\/p><\/li><li><p>Never ridicule or yell at a child for making a mistake or losing a competition.<\/p><\/li><li><p>Remember that children learn best by example.<\/p><\/li><li><p>Support all efforts to remove verbal and physical abuse from sporting activities.<\/p><\/li><li><p>Respect officials\u2019 decisions and teach children to do likewise.<\/p><\/li><li><p>Show appreciation for coaches, officials and administrators.<\/p><p><\/p><\/li><\/ul>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">New Zealand Football expects all Federations, clubs, organisations, employees, members, referees, administrators, associates, coaches, players, volunteers and parents or guardians to understand the possible consequences of breaching the Code of Conduct and ensure that they abide by the Code.<\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">Any serious breaches of this Code of Conduct or persistent violations of any aspect of the Code of Conduct, by any of the above may result in any of the following being imposed:<\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">\u2022 Suspension<\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">\u2022 Good behaviour bond<\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">\u2022 Fines<\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">\u2022 Loss of competition points<\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">\u2022 Loss of match<\/p>\n\n<h4 style=\"margin-top: 24px; margin-bottom: 16px; font-size: 18px; line-height: 1.4; font-weight: bold;\">Acknowledgements:<\/h4>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">FIFA<\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">Football Federation Australia<\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">SPARC<\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">Swimming NZ<\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">United States Football Federation<\/p>\n        <\/div>\n        <!--[if (gte mso 9)|(IE)]>\n        <\/td>\n        <\/tr>\n        <\/table>\n        <![endif]-->","date":"2025-05-06 00:51:05","show_date":true,"editable":false,"location":null,"location_latitude":null,"location_longitude":null,"status":"published","user":{"id":"gGARcL6","first_name":"Administration","last_name":"Manager","avatar_url":"","cw_admin":false,"last_active_date":"2026-06-30 05:16:24"},"created_date":"2025-05-06 00:51:05","updated_date":"2025-05-06 01:22:26","average_rating":0,"attachments":[],"sender_organisation":null,"attributed_article":null,"blocks":null,"default_description":"All football players in New Zealand are governed by the N Z Football Code of Conduct...","org_name":"Selwyn United FC","website":false,"shared_to_app":false,"noindex":false,"deleted_date":null,"tags":[],"private_tags":[],"short_gallery":[],"short_video_gallery":[],"hero_image":{"id":"9qBDdJS","caption":null,"people":null,"location":null,"location_latitude":null,"location_longitude":null,"date":"2025-05-06 01:12:33","editable":false,"photographer":null,"camera":null,"status":"approved","file_150_square_url":"https:\/\/assets.hail-cdn.com\/uploads\/150x150-712a88bb-2b41-4f0e-886f-6264cfbe06a9","file_500_url":"https:\/\/assets.hail-cdn.com\/uploads\/500-constrained-1527ece2-f36d-4a98-bada-6d409d3da6b4","file_500_square_url":"https:\/\/assets.hail-cdn.com\/uploads\/500x500-f618fab1-9022-4a07-abae-e0eefbe4e4d8","file_1000_url":"https:\/\/assets.hail-cdn.com\/uploads\/1000-constrained-81097d3e-fef3-4c8e-934c-ce8491a3c4ab","file_1000_square_url":"https:\/\/assets.hail-cdn.com\/uploads\/1000x1000-36c3f9de-5c14-4edc-aae2-c0439aa55525","file_2000_url":"https:\/\/assets.hail-cdn.com\/uploads\/2000-constrained-ec01e71b-3bad-4e04-9a1f-b3732d38767a","file_original_url":"https:\/\/assets.hail-cdn.com\/uploads\/original-98c14f62-3086-45a7-b8d0-c099019a94d2","original_width":313,"original_height":315,"focal_point":null,"colour_palette":{"background":{"rgb":{"red":255,"green":255,"blue":255}},"primary":{"rgb":{"red":105,"green":91,"blue":80}},"secondary":{"rgb":{"red":41,"green":32,"blue":25}},"detail":{"rgb":{"red":0,"green":0,"blue":0}}},"tags":[],"private_tags":[],"user":{"id":"gGARcL6","first_name":"Administration","last_name":"Manager","avatar_url":"","cw_admin":false,"last_active_date":"2026-06-30 05:16:24"},"amnesty_expiry":"2025-05-07 01:12:33","created_date":"2025-05-06 01:12:33","average_rating":0,"sender_organisation":null,"attributed_image":null,"noindex":false,"deleted_date":null},"hero_video":null,"url":"https:\/\/hail.to\/selwyn\/article\/Na6GKH8","hail_url":"https:\/\/hail.to\/selwyn\/article\/Na6GKH8","order":null},"title":"New Zealand Football Code of Conduct"},"depth":1,"parent":24852,"left":90,"right":91},{"id":"Wf8MiJC","name":"Playing Kit & Merchandise Policy","type":"link","in_use":true,"display_homepage":true,"display_magazines":false,"display_gazettes":false,"display_newsletters":false,"display_noticeboards":false,"display_blogs":false,"display_yearbooks":false,"display_articles":false,"ordering_id":24849,"association":{"type":"article","entity":{"id":"9RWorMZ","title":"SUFC Playing Kit and Merchandise Policy","author":"Administration Manager","show_author":true,"lead":null,"body":"<a href=\"https:\/\/assets.hail-cdn.com\/uploads\/2000-constrained-4c16cbf7-a1e1-495d-bea5-0ccfb0c8777e\" class=\"hail-inline\" target=\"_blank\" style=\"text-align: center;\" data-caption=\"\" data-people-html=\"\" data-grapher=\"\" data-width=\"1575\" data-height=\"2000\"><figure text-align=\"center\" data-hail-inline-id=\"J6cvxkE\" data-hail-inline-type=\"image\" data-hail-width-percentage=\"21.236559139784948\" style=\"text-align: center;\"><div class=\"public-image-wrapper\" style=\"width: 21.236559139784948%;\"><img src=\"https:\/\/assets.hail-cdn.com\/uploads\/1000-constrained-2a26a98b-f4c2-4276-a6ae-0709e68c461e\"><\/div><\/figure><\/a>\n\n<p><\/p>\n\n<h3><strong>Playing Kit and Merchandise Policy<\/strong><\/h3>\n\n<p>&nbsp;<\/p>\n\n<p><strong>Introduction&nbsp;<\/strong><\/p>\n\n<p>This policy has been created to protect Selwyn United Football Club\u2019s ownership and control over key club assets including on-field club and talent centre playing kits, on and off-field club merchandise and use of the club logo and the Selwyn United Football Club name.&nbsp; Protecting these assets is important for maintaining the club\u2019s brand and identity.<\/p>\n\n<p><\/p>\n\n<p><strong>Ownership of Playing Kits&nbsp;<\/strong><\/p>\n\n<p>The club will at all times retain sole ownership of all playing kits, training apparel and any other items of clothing bearing the club logo, unless purchased via the approved Selwyn United merchandise store, or specifically outlined as belonging, or gifted, to a player in a document signed by the club representative, eg An Amateur Player Agreement.<\/p>\n\n<p>&nbsp;<\/p>\n\n<p>Players, staff, contractors, volunteers, coaches, etc. are provided these items to wear when representing the club, but ownership is not transferred. Items must be returned to the club at the end of each season or if the individual is no longer a member, staff, contractor or volunteer at the club. Failure to do so may result in the items being invoiced at full cost to the individual and, in case of a player, being red flagged in New Zealand Football\u2019s player register, stopping them from transferring to play for another club within New Zealand.<\/p>\n\n<p>&nbsp;<\/p>\n\n<p>To ensure clarity, any team or individual representing Selwyn United must only wear official club-endorsed playing kit and off-field Selwyn United branded merchandise. No team or individual is permitted to procure or wear any non-official playing kit or merchandise while representing Selwyn United. &nbsp;<\/p>\n\n<p>&nbsp;<\/p>\n\n<p>&nbsp;<strong>Use and Reproduction of Club Logo and Selwyn United Football Club name<\/strong>&nbsp;<\/p>\n\n<p>The club logo, name and value statements, including all variations and designs, are copyright and trademarks of the club. They cannot be reproduced or used without written permission from the Board. This includes usage on third party websites, social media pages, merchandise, etc. A fee (usually by way of a sponsorship agreement) may apply for approved commercial use by third parties.<\/p>\n\n<p>&nbsp;<\/p>\n\n<p><strong>Sale of Club Merchandise&nbsp;<\/strong><\/p>\n\n<p>Only merchandise and apparel officially licenced or produced through the club\u2019s supplier is approved to bear the club\u2019s logo, name or value statements. For the avoidance of doubt, use of the club logo, name or value statements for self-produced or self-sourced items sold by individuals or other parties is not permitted.<\/p>\n\n<p>&nbsp;&nbsp;<\/p>\n\n<p><strong>Enforcement and Disciplinary Action<\/strong>&nbsp;<\/p>\n\n<p>Failure to comply with this policy may result in disciplinary action. This includes requests to return items, cease the wearing of these when representing the club, potential club membership sanctions and legal action to cease unauthorised commercial usage of the logo.<\/p>\n\n<p>&nbsp;<\/p>\n\n<p>The Board will enforce this policy to maintain ownership and control of key club branding and assets.<\/p>\n\n<p>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;January 2025&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<\/p>","body_mail":"\n        <!--[if (gte mso 9)|(IE)]>\n        <table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" width=\"516\">\n        <tr>\n        <td>\n        <![endif]-->\n        <div style=\"max-width: 516px; margin: 0 auto; box-sizing: border-box; font-family: sans-serif; font-size: 18px; line-height: 1.6; color: #475569;\">\n        <a ses:no-track href=\"https:\/\/assets.hail-cdn.com\/uploads\/2000-constrained-4c16cbf7-a1e1-495d-bea5-0ccfb0c8777e\" target=\"_blank\" style=\"text-decoration: none; border: none; outline: none;\" class=\"hail-inline\" data-caption=\"\" data-grapher=\"\" data-width=\"1575\" data-height=\"2000\"><figure text-align=\"center\" data-hail-inline-id=\"J6cvxkE\" data-hail-inline-type=\"image\" data-hail-width-percentage=\"21.236559139784948\" style=\"text-align: center; margin: 0; padding: 0;\"><div class=\"email-image-wrapper\" style=\"display: inline-block; width: 21%; max-width: 118px; vertical-align: top; text-align: center;\"><img src=\"https:\/\/assets.hail-cdn.com\/uploads\/1000-constrained-2a26a98b-f4c2-4276-a6ae-0709e68c461e\" alt=\"\" width=\"118\" style=\"width: 100%; height: auto; max-width: 118px; border: 0; display: block; outline: none; text-decoration: none; -ms-interpolation-mode: bicubic;\"><\/div><\/figure><\/a>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\"><\/p>\n\n<h3 style=\"margin-top: 24px; margin-bottom: 16px; font-size: 20px; line-height: 1.4; font-weight: bold;\"><strong style=\"font-weight: bold;\">Playing Kit and Merchandise Policy<\/strong><\/h3>\n\n<p style