  window.HAIL.articles = [{"id":"P4Ev50c","title":"Girl's Development Sessions - Term 2 2026","author":"SUFC","show_author":true,"editable":false,"lead":"Register today to take part in our Girl's Development sessions this coming term.","body":"<p>Selwyn United FC is once again running our Girl's Development Sessions in Term 2 2026.<\/p>\n\n<p>The weekly sessions will be held on a Thursday for girls aged 5-12 years old wanting to improve their skills across the whole game.<\/p>\n\n<p><strong>Time:<\/strong>&nbsp;5.00pm-6.00pm on Thursdays<\/p>\n\n<p><strong>Ages:<\/strong>&nbsp;5-12<\/p>\n\n<p><strong>Cost:<\/strong> $85.00 for the term | Term 2 | Thursday 23rd April to Thursday 2nd July 2026<\/p>\n\n<p><strong>Where: <\/strong>Foster Park (70 Broadlands Dr)<\/p>\n\n<p>Any skill levels are welcome.<\/p>\n\n<p>To register <a href=\"https:\/\/forms.gle\/fvLshvtVYdYNnrP1A\" data-button=\"true\" class=\"button-link\">CLICK HERE<\/a><\/p>\n\n<p><\/p>","date":"2026-04-15 22:08:29","show_date":true,"location":null,"location_latitude":null,"location_longitude":null,"status":"published","created_date":"2026-04-15 22:08:29","updated_date":"2026-04-15 22:14:41","average_rating":0,"attachments":[],"sender_organisation":null,"attributed_article":null,"blocks":[],"default_description":"Register today to take part in our Girl's Development sessions this coming term....","org_name":"Selwyn United FC","user":{"id":"gGARcL6","first_name":"Administration","last_name":"Manager","avatar_url":"","cw_admin":false,"last_active_date":"2026-06-30 05:16:24"},"videos":[],"tags":[],"private_tags":[],"images":[{"id":"GHU594a","file_150_square_url":"https:\/\/assets.hail-cdn.com\/uploads\/150x150-5d3f3dc5-c912-4b24-b323-6645cf86cf9e","file_500_url":"https:\/\/assets.hail-cdn.com\/uploads\/500-constrained-a2bedfd1-febf-411f-9c44-bd393ffee1c0","file_500_square_url":"https:\/\/assets.hail-cdn.com\/uploads\/500x500-b51a7190-dc6e-4b7b-a96c-a30503703dec","caption":null,"people":null,"file_1000_url":"htt