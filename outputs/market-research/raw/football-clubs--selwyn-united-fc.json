ll,"location_latitude":null,"location_longitude":null,"zoom_level":15,"map_type":"roadmap","image":{"id":"tAEZe0R","file_150_square_url":"https:\/\/assets.hail-cdn.com\/uploads\/150x150-a068de11-07ff-4836-b8be-717ffc512e87","file_500_url":"https:\/\/assets.hail-cdn.com\/uploads\/500-constrained-c5552a9d-fcbe-40ed-a89d-d7e029d3a7e6","file_500_square_url":"https:\/\/assets.hail-cdn.com\/uploads\/500x500-ebb0a130-951a-4e72-bf21-e1b6a1be9ae2","caption":null,"people":null,"file_1000_url":"https:\/\/assets.hail-cdn.com\/uploads\/1000-constrained-25856912-2d28-46f5-9a1b-9ff03e58d4a2","file_1000_square_url":"https:\/\/assets.hail-cdn.com\/uploads\/1000x1000-3d7b9c41-90d6-4a60-a64a-fcc19dfb05e1","file_2000_url":"https:\/\/assets.hail-cdn.com\/uploads\/2000-constrained-b323f34a-79e6-481a-8214-fe1e03fa9107","original_width":1640,"original_height":924,"focal_point":null},"video":null,"association":{"id":"RwzIFNn","url":"https:\/\/hail.to\/selwyn\/article\/RwzIFNn","type":"article","title":"Selwyn Talent Centre","data":null},"body_text":"","body_text_public":""}],"count":4,"location_ref":"website-promo","order":0,"in_use":false}]},"banner_articles":[{"id":"H6fQvUn","title":"2026 Winter Football Registration Guide","author":"Administration Manager","show_author":true,"editable":false,"lead":"Registrations for the 2026 Winter Football season are now <strong>closed<\/strong>.We still have some vacancies in 8th, 9th, 10th &amp; 12th Grade teams, please contact admin@sufc.nz if you would like to join one of these teams.","body":"<h3><strong>REGISTRATION GUIDE<\/strong><\/h3>\n\n<p><strong>\u200bIf you are new to Selwyn United FC<\/strong><\/p>\n\n<p>Your first step is to complete the online registration form, this will create a profile for you with Friendly Manager in our system.<\/p>\n\n<ul><li><p>Fill out the registration form in full and complete the payment details<\/p><\/li><li><p>You will receive a confirmation email with a link to the registration details.<\/p><\/li><\/ul>\n\n<p>You can register more than one member at a time, just click on the green button \"Add another member\"<\/p>\n\n<p><\/p>\n\n<p><\/p>\n\n<p><strong>If you have a Selwyn United FC Friendly Manager link<\/strong><\/p>\n\n<ul><li><p>Click on the link you have been sent to open your profile.<\/p><\/li><li><p>Once you are in your profile you can click on Menu then Register<\/p><\/li><li><p>Choose the Football New Zealand Registration (2026) form and who is registering and follow the registration steps.<\/p><\/li><li><p>Please review and update all information as this may have changed since you last registered.<\/p><\/li><li><p>If you are unable to access your login details, please email <a href=\"mailto:admin@sufc.nz\">admin@sufc.nz<\/a> with the player's full name and date of birth. We will get back to you as soon as we can, but it can take a little longer during peak registrations, February to April.<\/p><\/li><\/ul>\n\n<p><\/p>\n\n<p>Please note: We operate a <strong>No Pay, No Play<\/strong> policy which means that players are not registered until payment of registration fees is confirmed.<br><\/p>\n\n<p>If you have not registered and paid for the 2026 season by the registration cutoff date you will not be guaranteed placement in a team.\u200b<\/p>\n\n<p><\/p>\n\n<p>Please also check and update your personal details, we communicate via e-mail and it is essential your details are correct.<\/p>\n\n<p><\/p>\n\n<p>\u200bIf you are still having trouble registering, please contact our Administration Manager Michelle <a href=\"mailto:admin@sufc.nz\">admin@sufc.nz<\/a><\/p>\n\n<h4>Mainland Football Scorching Goal Fund<\/h4>\n\n<p>\u200bThe Scorching Goal Football Fund has been established to assist children and youth attending primary or secondary school, aged between 5 years and 18 years who are from financially disadvantaged families or backgrounds, and where finance is a barrier to participation, either at club level, across development programmes or at representative level.<\/p>\n\n<p>This is not a fund established to specifically support talented players but is rather about providing children and youth with the opportunity to continue to participate in football.\u200b<\/p>\n\n<p>Please click <a href=\"https:\/\/www.mainlandfootball.co.nz\/ABOUT-1\/Resources\/Scorching-Goal-1\">here<\/a> for more information on the Mainland Football website.<\/p>\n\n<p>\u200b<br><\/p>","date":"2026-02-03 01:10:00","show_date":true,"location":null,"location_latitude":null,"location_longitude":null,"status":"published","created_date":"2024-02-08 01:10:52","updated_date":"2026-06-10 22:25:26","average_rating":0,"attachments":[{"id":"yMw7zX3","uploaded_name":"2026 SUFC Membership  Subscription Policy","uploaded_extension":"pdf","mime_type":"application\/pdf","file_size":212363,"url":"https:\/\/assets.hail-cdn.com\/uploads\/31f137bf-beb9-400c-bb43-17858e0544c8.pdf","name":"2026 SUFC Membership  Subscription Policy"}],"sender_organisation":null,"attributed_article":null,"blocks":[],"default_description":"Registrations for the 2026 Winter Football season are now closed.We still have some vacancies in 8th, 9th, 10th &amp; 12th Grade teams, please contact...","org_name":"Selwyn United FC","user":{"id":"gGARcL6","first_name":"Administration","last_name":"Manager","avatar_url":"","cw_admin":false,"last_active_date":"2026-06-30 05:16:24"},"videos":[],"tags":[],"private_tags":[],"hero_image":{"id":"Xxm4O5e","caption":null,"people":null,"location":null,"location_latitude":null,"location_longitude":null,"date":"2023-12-08 04:57:08","editable":false,"photographer":"Administration Manager","camera":null,"status":"approved","file_150_square_url":"https:\/\/assets.hail-cdn.com\/tmJzlLSbzmNK8oGTXHd0ClRM7U63DNQDrUrFF0LJX0w9HfzDUmNLHUQmT187rNZLl6sbqgxKqrGkiS2ryoVhcB4as5V3XDxhpNvaODm9lONkcAxP35sTCfvzLTySyydh","file_500_url":"https:\/\/assets.hail-cdn.com\/cOqt5OTiy2zGAywSmNm5Ubxml83uVHHJYEvNRWbWuE7U03ocnY83w9Xr6LRNmIrntjRUM3PueDtMRuoBpB5BwaAUrgJD1zwbdinAfT2fvPgUQArnCs53wzpAOYmwtka9","file_500_square_url":"https:\/\/assets.hail-cdn.com\/R4BRksUfggD57YJ57hUE2dP14kbZGG1w0TrXaSwU5AW05BUlXt7lKSmI0MQqAr5CMO8BU6M1eRJnaZzALjBd4j83bGxVeCSj81oxXvI2OVYEMcys8mNvls84fYDzhwUE","file_1000_url":"https:\/\/assets.hail-cdn.com\/KsX3e3UND89D8s639NY6kzGGANGD7B33RPxgTlWlsAm2Qu8xhX3LL4iGrkn1iHKmbr8zUyHRnW5mk87BUKKWQDjl52ubBuTX5FhAg6mL2yoPyyjpN4GWUpD29cuZTxeM","file_1000_square_url":"https:\/\/assets.hail-cdn.com\/hxtPRcBf7fRn4wIvOvGKpzgvwPFAn4VQjqFMkHhk74uxSmp1UXTGlJBNqR8kySbkRUCJaYCJGBFY0nuOMmA5HSnh1GuMM7ZmJPRCXhpLXXBHLO1QJ36vCUa8PPvmjxDC","file_2000_url":"https:\/\/assets.hail-cdn.com\/7AXhtMpToHIlMKvX015XgO0BCGeMrpZPEkPzbZVaZQSV8iCfjxYVHUoR0n1FWIdzy9NoU5otbLck3nzfZPHB1AF5q5zDBK2j5sxuBJujvOKnMfk95kZZZzL4BEnGzx6j","file_original_url":"https:\/\/assets.hail-cdn.com\/tsZ5SCTM2HNtWU26mDQTfPK6N1sMaH0aG5Ryk3BECDK7x8ZOf3mPf2dbH0xwO1kFcNaqxWEXok7aXHV0olBqGYeTmvtloTlX1HzDggVQ2kVgHGpJPEoG53tUqTXxEw2K","original_width":800,"original_height":1016,"focal_point":null,"colour_palette":{"background":{"rgb":{"red":255,"green":255,"blue":255}},"primary":{"rgb":{"red":0,"green":52,"blue":124}},"secondary":{"rgb":{"red":101,"green":112,"blue":120}},"detail":{"rgb":{"red":0,"green":0,"blue":0}}},"tags":[],"private_tags":[],"user":{"id":"gGARcL6","first_name":"Administration","last_name":"Manager","avatar_url":"","cw_admin":false,"last_active_date":"2026-06-30 05:16:24"},"amnesty_expiry":"2023-12-09 04:57:08","created_date":"2023-12-08 04:57:09","average_rating":0,"sender_organisation":null,"attributed_image":null,"noindex":false,"deleted_date":null},"hero_video":null,"url":"https:\/\/hail.to\/selwyn\/article\/H6fQvUn","hail_url":"https:\/\/hail.to\/selwyn\/article\/H6fQvUn","order":1},{"id":"7AJxIF3","title":"2026 Selwyn Development Centre, Skill Centre and Talent Centre","author":"SUFC","show_author":true,"editable":false,"lead":"Selwyn United Development Centre, Skill Centre &amp; Talent Centre sessions are back for 2026 at Foster Park, Rolleston.","body":"<h3><strong>Selwyn United 7th - 9th Grade Development Centre<\/strong><\/h3>\n\n<p>The Development Centre sessions are designed for players aged 7 years old to 9 years old who want a little extra training each week to improve their technical ability and foster their development.<\/p>\n\n<p style=\"text-align:left;\"><\/p>\n\n<p style=\"text-align:left;\">They are open to any players aged 7 years to 9 years old who want to enhance their skill development, the sessions are fun and inclusive to all. Come and play, learn and excel through football.<\/p>\n\n<p style=\"text-align:left;\"><\/p>\n\n<p style=\"text-align:left;\">If a player has the motivation to learn and be challenged, then these sessions may be just what you are looking for.<\/p>\n\n<p style=\"text-align:left;\"><\/p>\n\n<p style=\"text-align:left;\">The Development Centre program has been designed to provide players with basic football fundamentals that can be practiced in a fun environment. The Development Centre will also act as stepping stone into the Skill Centre, following the same focuses, however, scaled down to suit the age groups.&nbsp;<\/p>\n\n<p style=\"text-align:left;\">Development Centre Focuses:<\/p>\n\n<p style=\"text-align:left;\">\u2022\u2002\u2002\u2002\u2002\u2002Ball Manipulation<\/p>\n\n<p style=\"text-align:left;\">\u2022\u2002\u2002\u2002\u2002\u20021v1 domination<\/p>\n\n<p style=\"text-align:left;\">\u2022\u2002\u2002\u2002\u2002\u20023v3-5v5 conditioned practice<\/p>\n\n<p style=\"text-align:left;\">\u2022\u2002\u2002\u2002\u2002\u2002Small Sided Games<\/p>\n\n<p style=\"text-align:left;\"><\/p>\n\n<p style=\"text-align:left;\">The sessions will be run on Tuesdays &amp; Thursdays 4pm to 5pm. Players can register for just one session or both sessions per week.<\/p>\n\n<h4><strong>Development Centre Costs<\/strong><\/h4>\n\n<p style=\"text-align:left;\">1 session per week $100 per term<\/p>\n\n<p style=\"text-align:left;\">2 sessions per week $200 per term<\/p>\n\n<p style=\"text-align:left;\">To register for these sessions please <a href=\"https:\/\/forms.gle\/ifvqFM2pp2rPvvwH8\"><strong>CLICK HERE<\/strong><\/a><\/p>\n\n<h3><strong>Selwyn United Skill Centre<\/strong><\/h3>\n\n<p>Selwyn United Skill Centre sessions are back for 2026.<\/p>\n\n<p>The Selwyn United Skill Centre is a New Zealand Football licensed Skill Centre programme designed for 10th \u2013 12th Grade players.&nbsp;<\/p>\n\n<p>As a club we are passionate on providing a program that is open to all players, the Selwyn Skill Centre is a program for any player who wants to improve their skills.<\/p>\n\n<p>Our vision is to inspire participation by providing a football environment that is of the highest-quality, fun and inclusive to all regardless of a player\u2019s motivation or ability. There is no one individual more important than another. We are united as a club and as a community, with the purpose of providing opportunities for our community to enjoy, play, learn and excel through football.<\/p>\n\n<p style=\"text-align:left;\">We also see development as something that goes well beyond simply playing the game. \u2018Good People First, Good Players Second\u2019.&nbsp;<\/p>\n\n<p style=\"text-align:left;\">We very firmly believe in developing the person as well as producing the player and having a process that is based around the individual needs of our players and the development of attributes in their game, that will see them develop and succeed in whatever pathway is right for them.<\/p>\n\n<p>The Skill Centre's focus is to provide an environment to develop key fundamentals within a player's skill set, while also creating a fun\/positive culture for players to make a lifelong connection to the game.<\/p>\n\n<h4>Skill Centre Focuses:<\/h4>\n\n<p>- Ball Manipulation<\/p>\n\n<p>- 1v1 domination<\/p>\n\n<p>- 3v3-5v5 conditioned practice<\/p>\n\n<p>- Small Sided Games<\/p>\n\n<p>Players can choose to have one or two sessions per week (in addition to their regular Winter Season club team training session).<\/p>\n\n<h4>Skill Centre Costs:<\/h4>\n\n<ul><li><p>1 session per week $150 per term<\/p><\/li><li><p>2 sessions per week $300 per term<\/p><p><\/p><p style=\"text-align:left;\"><a href=\"https:\/\/forms.gle\/hP52tJQLAaNcgkm86\"><strong>To register your interest in having your daughter or son involved with the SUFC Skill Centre program please click this link<\/strong><\/a><\/p><p style=\"text-align:left;\"><strong><em>Please note that this link IS NOT a registration link. It is simply just registering an interest. Soon after completing the form, you will receive an email with more information.<\/em><\/strong><\/p><\/li><\/ul>\n\n<h4>Training Schedule for Term 1<\/h4>\n\n<p><strong>10th Grade<\/strong><\/p>\n\n<p>Tuesday: 4pm-5pm \u2013 Foster Park turf<\/p>\n\n<p>Thursday: 4pm-5pm \u2013 Foster Park turf<\/p>\n\n<p><strong>11th Grade<\/strong><\/p>\n\n<p>Tuesday: 4pm-5pm \u2013 Foster Park turf<\/p>\n\n<p>Thursday: 4pm-5pm \u2013 Foster Park turf<\/p>\n\n<p><strong>12th Grade<\/strong><\/p>\n\n<p>Tuesday: 4pm-5pm \u2013 Foster Park turf<\/p>\n\n<p>Thursday: 4pm-5pm \u2013 Foster Park turf<\/p>\n\n<h3><strong>Selwyn Talent Centre<\/strong><\/h3>\n\n<p>Selwyn United Talent Centre sessions are back for 2026.&nbsp;<\/p>\n\n<p>The Selwyn United Talent Centre is a New Zealand Football licensed Talent Centre Program for our Colts squads who play in the Canterbury Development Leagues.<\/p>\n\n<h4>Training Schedule for Term 1<\/h4>\n\n<p>13th Grade \u2013 Monday &amp; Tuesday - 5.15pm-6.30pm<\/p>\n\n<p>14th Grade \u2013 Tuesday &amp; Thursday - 5.15pm-6.30pm<\/p>\n\n<p>15th Grade \u2013 Tuesday &amp; Thursday - 5.15pm-6.30pm<\/p>\n\n<p>17th Grade - Monday Foster Park grass, Tuesday &amp; Thursday Foster Park turf 5.15pm - 6.30pm<\/p>\n\n<h4>Talent Centre Costs<\/h4>\n\n<p>$395 per term + compulsory Training Kit-purchased by the player and worn to all training sessions and tournaments, consists of training t shirt, training shorts, pullover, black socks and a bag, approx. cost $235.00 per set.<\/p>\n\n<p><\/p>\n\n<p>To register your interest in having your daughter or son trial for Selwyn Talent Centre please <a href=\"https:\/\/docs.google.com\/forms\/d\/e\/1FAIpQLSe6MHf_NxLghhY7iP0OX1rLMfgFNcm5Hmx6CBXqZUm3niYqkg\/viewform\">CLICK HERE<\/a><\/p>\n\n<p>*Please note that this link is NOT a registration, it is simply just registering an interest. Soon after completing the form, you will receive an email with more information.&nbsp;<br><\/p>\n\n<p>If you have any questions regarding Development Centre, Skill Centre or Talent Centre, please contact Chris Brown <a href=\"mailto:dof@sufc.nz\">dof@sufc.nz<\/a><br><\/p>\n\n<p><br><\/p>","date":"2026-01-17 11:00:00","show_date":true,"location":null,"location_latitude":null,"location_longitude":null,"status":"published","created_date":"2025-01-20 01:14:46","updated_date":"2026-01-17 22:39:49","average_rating":0,"attachments":[],"sender_organisation":null,"attributed_article":null,"blocks":[],"default_description":"Selwyn United Development Centre, Skill Centre &amp; Talent Centre sessions are back for 2026 at Foster Park, Rolleston....","org_name":"Selwyn United FC","user":{"id":"gGARcL6","first_name":"Administration","last_name":"Manager","avatar_url":"","cw_admin":false,"last_active_date":"2026-06-30 05:16:24"},"videos":[],"tags":[{"id":"cYDa1qI","name":"Development","description":null},{"id":"qFtKO5i","name":"Events","description":null},{"id":"oGfeY1H","name":"Girls","description":null},{"id":"7dyJ3es","name":"Junior","description":null},{"id":"ekYOsjz","name":"People","description":null},{"id":"oibWg9P","name":"Programme","description":null}],"private_tags":[],"hero_image":{"id":"kHpzm4K","caption":null,"people":null,"location":null,"location_latitude":null,"location_longitude":null,"date":"2022-02-04 06:24:31","editable":false,"photographer":"General Manager","camera":null,"status":"approved","file_150_square_url":"https:\/\/assets.hail-cdn.com\/6QxVh8bUkLiqf5hrc73Bal3puwDSx