,"blue":38}},"primary":{"rgb":{"red":255,"green":255,"blue":255}},"secondary":{"rgb":{"red":150,"green":160,"blue":169}},"detail":{"rgb":{"red":185,"green":214,"blue":251}}},"tags":[],"private_tags":[],"user":{"id":"tuL3dVv","first_name":"Darren","last_name":"Sudlow","avatar_url":"https:\/\/assets.hail-cdn.com\/mV3VzlTKCx9On9Ex7vWddZ2j7645jJsrAXIGajpkDnDFjF8Ws6dKoaCGuj0gnxVHWdlUukag87xHVgpobg5kKRCh5NzUd0JwhE27pCtrqLvx89cIZXb7yRD1Zm5GoWLD","cw_admin":false,"last_active_date":"2026-06-28 21:54:07"},"amnesty_expiry":"2020-12-01 07:30:02","created_date":"2020-11-30 07:30:03","average_rating":0,"sender_organisation":null,"attributed_image":null,"noindex":false,"deleted_date":null},"hero_video":null,"url":"https:\/\/hail.to\/selwyn\/article\/4hO46bB","hail_url":"https:\/\/hail.to\/selwyn\/article\/4hO46bB","order":null},"title":"About Us"},"depth":1,"parent":10511,"left":4,"right":5},{"id":"nGxxoQE","name":"Our Grounds","type":"link","in_use":true,"display_homepage":true,"display_magazines":true,"display_gazettes":true,"display_newsletters":true,"display_noticeboards":false,"display_blogs":true,"display_yearbooks":true,"display_articles":true,"ordering_id":10513,"association":{"type":"article","entity":{"id":"dPFhuOa","title":"Our Grounds","author":"SUFC","show_author":true,"lead":"Selwyn United is a district wide club that has a number of homes","body":"<a href=\"https:\/\/assets.hail-cdn.com\/N5NOmoHz9dkN3mj07AjDT7UlUUReeEtcqWeuSIQ8xslVgyFD7zojWc1nQjFBGNPBNgssdkjlAIzBzlfywBzo0cnL3cC72B1dPFG1YHfxAtlJSymlfO0L5131MzlmTf6L\" class=\"hail-inline\" target=\"_blank\" style=\"text-align: center;\" data-caption=\"\" data-people-html=\"\" data-grapher=\"Khalil Gerbeaux\" data-width=\"2000\" data-height=\"1217\"><figure text-align=\"center\" data-hail-inline-id=\"NLpy7PX\" data-hail-inline-type=\"image\" data-hail-width-percentage=\"\" style=\"text-align: center;\"><div class=\"public-image-wrapper\" style=\"width: %;\"><img src=\"https:\/\/assets.hail-cdn.com\/xBs65AGjqmVk7ZIumGW7ESZkes8h8PE4BVRgBljQiZ30ENobtHQGwUKcLb8WrLwL1QLqWhJYEwBlG1k7OzbRTZuxFjdVyouK3dRr9UYPwtqFwGfUqaw35cKFm1zQ1AGz\"><figcaption style=\"text-align: center;\">Image by: Khalil Gerbeaux<\/figcaption><\/div><\/figure><\/a>\n\n<p><strong><br><\/strong><\/p>\n\n<p><strong>Rolleston<\/strong>:<\/p>\n\n<p>In 2016 we moved to our new home grounds at Foster Park in Rolleston. This fantastic space has 1 Senior, 2 Intermediate, 3 Junior and 12 First Kicks\/Fun Football fields all under lights, as well as an additional 3 Senior, 1 Youth Premier, 2 Intermediate and 3 Junior fields on the non-lit side of the park and now we also have a fully lit artificial turf with 1 senior or 2 intermediate or 4 junior fields.<br><\/p>\n\n<p>The fields are located right next to the Selwyn Sports Centre, Broadlands Drive, Rolleston.&nbsp;<\/p>\n\n<p>We also have two senior fields at our old home ground Brookside Park, which is just down the road from Foster Park.<\/p>\n\n<p><em>Foster Park Field Map<\/em><\/p>\n\n<p><\/p>\n\n<a href=\"https:\/\/assets.hail-cdn.com\/uploads\/2000-constrained-2f591d86-f4f9-4423-a147-98c7370b3644\" class=\"hail-inline\" target=\"_blank\" style=\"text-align: center;\" data-caption=\"\" data-people-html=\"\" data-grapher=\"\" data-width=\"1988\" data-height=\"2000\"><figure text-align=\"center\" data-hail-inline-id=\"DFp519a\" data-hail-inline-type=\"image\" data-hail-width-percentage=\"100\" style=\"text-align: center;\"><div class=\"public-image-wrapper\" style=\"width: 100%;\"><img src=\"https:\/\/assets.hail-cdn.com\/uploads\/1000-constrained-e511b4ed-a70b-46f5-b427-1af14a04d9ab\"><\/div><\/figure><\/a>\n\n<p><br><\/p>\n\n<p><em>Brookside Park Field Map<\/em><\/p>\n\n<a href=\"https:\/\/assets.hail-cdn.com\/uploads\/2000-constrained-3f5f5f61-4480-46aa-9359-97f31f041f54\" class=\"hail-inline\" target=\"_blank\" style=\"text-align: center;\" data-caption=\"\" data-people-html=\"\" data-grapher=\"\" data-width=\"2000\" data-height=\"1912\"><figure text-align=\"center\" 