  window.HAIL.homepage = {"id":"4Bhzo9X","slug":null,"org_name":"Selwyn United FC","title_prefix":"Welcome to","content_alignment":null,"hero_button_link":null,"hero_button_text":null,"hero_description":null,"title":"Selwyn United FC","logo":null,"information":"<h3>Welcome!<\/h3>\n\n<p>Selwyn United Football Club has quickly established itself as one of the biggest clubs in not only Christchurch, but the South Island. With strength in junior and youth participation, strong senior participation and world-class facilities. The club currently boasts over 1,600 members from all over the Selwyn District.<br><\/p>","information_aside":"<p><\/p>\n\n<p><\/p>\n\n<p><\/p>\n\n<h3>Bank Account Details<\/h3>\n\n<p>Bank account - Selwyn United FC 020860 0039650 01, please include player name &amp; team on any payments.<\/p>\n\n<h3>Key Partners<\/h3>\n\n<p>Selwyn United FC is proud to work alongside our key partners for 2026;<\/p>\n\n<p><a href=\"https:\/\/nz.paladin.sport\/\">Paladin Sports \/ <\/a><a href=\"https:\/\/arborgreen.nz\/\">Arbor Green<\/a>&nbsp;\/<a href=\"https:\/\/www.hanmerholidayhomes.co.nz\/\">Hanmer Holiday Homes<\/a>&nbsp;<a href=\"https:\/\/thepedalpusher.co.nz\/#carousel_614267772_1\">The Pedal Pusher Rolleston<\/a> \/ <a href=\"https:\/\/www.pubcharitylimited.org.nz\/grants\">Pub Charity<\/a><\/p>","custom_zoom_level":null,"status":"published","article_ordering":"none","publication_ordering":"date","blocks":[],"quick_links":[{"id":"VkGKsv6","name":"About Us","type":"folder","in_use":false,"display_homepage":true,"display_magazines":false,"display_gazettes":false,"display_newsletters":false,"display_noticeboards":false,"display_blogs":false,"display_yearbooks":false,"display_articles":false,"ordering_id":10511,"children":[{"id":"Av0AY8F","name":"About Us","type":"link","in_use":true,"display_homepage":true,"display_magazines":true,"display_gazettes":true,"display_newsletters":true,"display_noticeboards":false,"display_blogs":true,"display_yearbooks":true,"display_articles":true,"ordering_id":10512,"association":{"type":"article","entity":{"id":"4hO46bB","title":"About Us","author":"SUFC","show_author":true,"lead":"Selwyn United Football Club is pleased to welcome players, parents and supporters to our website!","body":"<p>Selwyn United Football Club is the result of the merger of Rolleston Football and Ellesmere Football Clubs in December 2012 and caters for all thing football in and around our district.&nbsp;<\/p>\n\n<p>Selwyn United Football Club has quickly established itself as one of the biggest clubs in not only Christchurch or the South Island but New Zealand. With the overwhelming strength in junior and youth participation, strong senior participation and world class facilities, the club currently boasts over 1,600 members from all over the Selwyn District.<\/p>\n\n<p>Selwyn United FC caters for males and females from the ages of 4 all the way up to over 50s giving an opportunity for people to play socially or competitively.&nbsp;<\/p>\n\n<p>Within the club there is a Skill Centre and a Talent Centre which aims to develop young footballer\u2019s skills, knowledge and understanding of the game and provide our players with a pathway to national football.&nbsp;<\/p>\n\n<p>Not only do the club offer a chance to play the game, its successful coach education and mentoring programme also allows people to become involved through coaching.&nbsp;<\/p>","body_mail":"\n        <!--[if (gte mso 9)|(IE)]>\n        <table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" width=\"516\">\n        <tr>\n        <td>\n        <![endif]-->\n        <div style=\"max-width: 516px; margin: 0 auto; box-sizing: border-box; font-family: sans-serif; font-size: 18px; line-height: 1.6; color: #475569;\">\n        <p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">Selwyn United Football Club is the result of the merger of Rolleston Football and Ellesmere Football Clubs in December 2012 and caters for all thing football in and around our district.&nbsp;<\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">Selwyn United Football Club has quickly established itself as one of the biggest clubs in not only Christchurch or the South Island but New Zealand. With the overwhelming strength in junior and youth participation, strong senior participation and world class facilities, the club currently boasts over 1,600 members from all over the Selwyn District.<\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">Selwyn United FC caters for males and females from the ages of 4 all the way up to over 50s giving an opportunity for people to play socially or competitively.&nbsp;<\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">Within the club there is a Skill Centre and a Talent Centre which aims to develop young footballer\u2019s skills, knowledge and understanding of the game and provide our players with a pathway to national football.&nbsp;<\/p>\n\n<p style=\"margin-top: 0; margin-bottom: 16px; line-height: 1.6;\">Not only do the club offer a chance to play the game, its successful coach education and mentoring programme also allows people to become involved through coaching.&nbsp;<\/p>\n        <\/div>\n        <!--[if (gte mso 9)|(IE)]>\n        <\/td>\n        <\/tr>\n        <\/table>\n        <![endif]-->","date":"2022-05-21 12:00:00","show_date":true,"editable":false,"location":null,"location_latitude":null,"location_longitude":null,"status":"published","user":{"id":"tuL3dVv","first_name":"Darren","last_name":"Sudlow","avatar_url":"https:\/\/assets.hail-cdn.com\/mV3VzlTKCx9On9Ex7vWddZ2j7645jJsrAXIGajpkDnDFjF8Ws6dKoaCGuj0gnxVHWdlUukag87xHVgpobg5kKRCh5NzUd0JwhE27pCtrqLvx89cIZXb7yRD1Zm5GoWLD","cw_admin":false,"last_active_date":"2026-06-28 21:54:07"},"created_date":"2018-08-19 03:42:28","updated_date":"2026-02-10 02:01:09","average_rating":0,"attachments":[],"sender_organisation":null,"attributed_article":